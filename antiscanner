#!/bin/bash
# antiscanner v3.3.3 — для Ubuntu 24.04 LTS
# Фиксы: cmd_help heredoc, auto-init CONF_DIR, RC propagation, nc detection
set -u

# =============== Цвета ===============
BOLD='\033[1m'; DIM='\033[2m'
B_CYAN='\033[1;36m'; B_GREEN='\033[1;32m'; B_YELLOW='\033[1;33m'
B_RED='\033[1;31m'; B_MAGENTA='\033[1;35m'; B_BLUE='\033[1;34m'
B_WHITE='\033[1;37m'; NC='\033[0m'

# =============== Пути ===============
CONF_DIR="/etc/antiscanner"
CONFIG="$CONF_DIR/config.conf"
WHITELIST="$CONF_DIR/whitelist.txt"
CURRENT="$CONF_DIR/current.list"
PREVIOUS="$CONF_DIR/previous.list"
LAST_DIFF="$CONF_DIR/last.diff"
PROTECTED_FILE="$CONF_DIR/protected.list"
TG_CONF="$CONF_DIR/telegram.conf"
REPORT_STATE="$CONF_DIR/report.state"
WATCH_STATE="$CONF_DIR/watch.state"
ALERTS_SEEN="$CONF_DIR/alerts.seen"
F2B_STATE="$CONF_DIR/fail2ban.state"
F2B_BANS="$CONF_DIR/fail2ban.bans"
GEOIP_CACHE="$CONF_DIR/geoip.cache"
LOG_UPDATE="/var/log/antiscanner_update.log"
LOG_BLOCKED="/var/log/antiscanner_blocked.log"
LOG_ALERTS="/var/log/antiscanner_alerts.log"
LOG_F2B="/var/log/antiscanner_fail2ban.log"
LOG_HP="/var/log/antiscanner_honeypot.log"
IPT_CHAIN="SCANNERS-BLOCK"
IPSET_F2B="antiscanner-f2b"
IPSET_HP="antiscanner-honeypot"

# =============== Дефолты ===============
ALERT_THRESHOLD=3
ALERT_WINDOW=300
ALERT_COOLDOWN=3600
F2B_MAX_FAILS=3
F2B_WINDOW=600
F2B_BAN_SECONDS=86400
HONEYPOT_PORTS="23 2222 3389 8080"
RATELIMIT_ENABLED=true
RATELIMIT_PORTS="22"
RATELIMIT_RATE="10/min"
RATELIMIT_BURST=15
BLOCKLIST_URL="https://gist.githubusercontent.com/sngvy/07cee7ac810c9d222fbebddff8c1d1b8/raw/blacklist.txt"
TG_API_IPV4="149.154.167.220"
NOTIFY_ALERTS=true
NOTIFY_REPORT=true
NOTIFY_HONEYPOT=false
NOTIFY_FAIL2BAN=false

# =============== Авто-инициализация CONF_DIR ===============
# Защита от ручного rm -rf /etc/antiscanner
if [ "$EUID" -eq 0 ]; then
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    chmod 755 "$CONF_DIR" 2>/dev/null || true
    for _f in whitelist.txt current.list previous.list watch.state \
              alerts.seen fail2ban.state fail2ban.bans geoip.cache \
              protected.list last.diff; do
        [ ! -e "$CONF_DIR/$_f" ] && touch "$CONF_DIR/$_f" 2>/dev/null || true
    done
    unset _f
fi

[ -f "$CONFIG" ] && { set +u; source "$CONFIG"; set -u; }

need_root() { [ "$EUID" -ne 0 ] && { echo -e "${B_RED}Нужны root${NC}"; exit 1; }; }
log_ts() { date '+%Y-%m-%d %H:%M:%S'; }
log_info()  { echo -e "$(log_ts) [${B_GREEN}INFO${NC}] $*"; }
log_warn()  { echo -e "$(log_ts) [${B_YELLOW}WARN${NC}] $*"; }
log_error() { echo -e "$(log_ts) [${B_RED}ERR ${NC}] $*" >&2; }

# =============== Определение nc ===============
detect_nc_bin() {
    if [ -x /bin/nc.traditional ]; then
        echo "/bin/nc.traditional"
    elif [ -x /usr/bin/nc.traditional ]; then
        echo "/usr/bin/nc.traditional"
    else
        if command -v nc >/dev/null 2>&1 && ! nc -h 2>&1 | grep -qi 'OpenBSD'; then
            command -v nc
        else
            echo ""
        fi
    fi
}

detect_mode() {
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qiE '^\s*Status:\s*active'; then
        echo "ufw"
    else
        echo "iptables"
    fi
}

# =============== Telegram ===============
send_telegram() {
    local msg="$1"
    [ ! -f "$TG_CONF" ] && return 1
    set +u; source "$TG_CONF"; set -u
    [ -z "${TG_BOT_TOKEN:-}" ] || [ -z "${TG_CHAT_ID:-}" ] && return 1
    [ ${#msg} -gt 4000 ] && msg="${msg:0:3900}

<i>...обрезано</i>"

    local resp attempt
    for attempt in 1 2 3 4 5; do
        resp=$(curl -sS -4 \
            --resolve "api.telegram.org:443:${TG_API_IPV4}" \
            --max-time 30 --connect-timeout 10 \
            -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
            -d "chat_id=${TG_CHAT_ID}" -d "parse_mode=HTML" \
            -d "disable_web_page_preview=true" \
            --data-urlencode "text=${msg}" 2>&1)

        if echo "$resp" | grep -q '"ok":true'; then
            [ "$attempt" -gt 1 ] && echo "[TG] OK (попытка $attempt)" >&2
            return 0
        fi

        if echo "$resp" | grep -q "can't parse entities"; then
            local plain
            plain=$(echo "$msg" | sed -E 's|</?[a-z][^>]*>||g')
            resp=$(curl -sS -4 \
                --resolve "api.telegram.org:443:${TG_API_IPV4}" \
                --max-time 30 --connect-timeout 10 -X POST \
                "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
                -d "chat_id=${TG_CHAT_ID}" \
                --data-urlencode "text=${plain}" 2>&1)
            if echo "$resp" | grep -q '"ok":true'; then
                echo "[TG] WARN: HTML невалиден, plain" >&2
                return 0
            fi
        fi

        if echo "$resp" | grep -q '"ok":false'; then
            echo "[TG ERROR] $(echo "$resp" | head -c 300)" >&2
            return 1
        fi

        echo "[TG] Попытка $attempt: сеть, повтор..." >&2
        sleep 3
    done

    echo "[TG ERROR] 5/5 fail: $(echo "$resp" | head -c 200)" >&2
    return 1
}

notify() {
    local module="$1"; shift
    local msg="$*"
    local var="NOTIFY_${module^^}"
    local enabled="${!var:-true}"
    [ "$enabled" != "true" ] && return 0
    send_telegram "$msg"
}

cmd_telegram() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root
            echo -e "${B_CYAN}═══ Настройка Telegram ═══${NC}"
            echo -e "${DIM}@BotFather → /newbot → TOKEN${NC}"
            echo -e "${DIM}Напишите боту /start, потом:${NC}"
            echo -e "${DIM}curl -s 'https://api.telegram.org/bot<TOKEN>/getUpdates'${NC}"
            echo
            read -rp "TG_BOT_TOKEN: " tok
            read -rp "TG_CHAT_ID:   " cid
            { echo "TG_BOT_TOKEN=\"$tok\""; echo "TG_CHAT_ID=\"$cid\""; } > "$TG_CONF"
            chmod 600 "$TG_CONF"
            echo -e "${B_GREEN}✓ Сохранено${NC}"
            read -rp "Тест? [Y/n]: " a
            [[ ! "$a" =~ ^[Nn]$ ]] && cmd_telegram test
            ;;
        test)
            if send_telegram "🛡 <b>AntiScanner</b> тест с <code>$(hostname -s)</code>"; then
                echo -e "${B_GREEN}✓ Отправлено${NC}"
            else
                echo -e "${B_RED}✗ Ошибка${NC}"
            fi
            ;;
        *)
            if [ -f "$TG_CONF" ]; then
                set +u; source "$TG_CONF"; set -u
                echo -e "${B_GREEN}✓ Telegram настроен${NC}"
                echo -e "  Token: ${B_YELLOW}${TG_BOT_TOKEN:0:10}...${NC}"
                echo -e "  Chat:  ${B_YELLOW}${TG_CHAT_ID}${NC}"
            else
                echo -e "${B_YELLOW}Не настроен. antiscanner telegram setup${NC}"
            fi
            ;;
    esac
}

# =============== GeoIP ===============
geoip_lookup() {
    local ip="$1"
    [ -z "$ip" ] && { echo "XX"; return; }
    touch "$GEOIP_CACHE" 2>/dev/null || true
    local cached
    cached=$(grep "^${ip} " "$GEOIP_CACHE" 2>/dev/null | awk '{print $2}' | head -1)
    if [ -n "$cached" ]; then echo "$cached"; return; fi
    local cc
    cc=$(curl -s --max-time 5 --connect-timeout 3 \
        "https://ipinfo.io/${ip}/country" 2>/dev/null | head -c 5 | tr -d '\r\n ')
    if [[ ! "$cc" =~ ^[A-Z]{2}$ ]]; then
        cc=$(curl -s --max-time 5 --connect-timeout 3 \
            "http://ip-api.com/line/${ip}?fields=countryCode" 2>/dev/null | head -c 5 | tr -d '\r\n ')
    fi
    [[ ! "$cc" =~ ^[A-Z]{2}$ ]] && cc="XX"
    echo "${ip} ${cc}" >> "$GEOIP_CACHE" 2>/dev/null || true
    echo "$cc"
    sleep 0.15
}

flag_emoji() {
    local cc="${1:-XX}"
    if [[ ! "$cc" =~ ^[A-Z]{2}$ ]]; then echo "🏳"; return; fi
    python3 -c 'import sys; c=sys.argv[1]; print(chr(127397+ord(c[0]))+chr(127397+ord(c[1])))' "$cc" 2>/dev/null || echo "🏳"
}

cmd_geoip() {
    case "${1:-cache}" in
        lookup)
            [ -z "${2:-}" ] && { echo "antiscanner geoip lookup <ip>"; return 1; }
            local cc fl; cc=$(geoip_lookup "$2"); fl=$(flag_emoji "$cc")
            echo -e "${2}: ${fl} ${cc}"
            ;;
        cache)
            if [ -s "$GEOIP_CACHE" ]; then
                echo -e "${B_CYAN}═══ GeoIP кеш ($(wc -l <"$GEOIP_CACHE") записей) ═══${NC}"
                head -30 "$GEOIP_CACHE" | while read -r ip cc; do
                    local fl; fl=$(flag_emoji "$cc")
                    printf "  %s  ${B_YELLOW}%-2s${NC}  %s\n" "$fl" "$cc" "$ip"
                done
                local t; t=$(wc -l <"$GEOIP_CACHE")
                [ "$t" -gt 30 ] && echo -e "${DIM}... и ещё $((t-30))${NC}"
            else
                echo -e "${DIM}кеш пуст${NC}"
            fi
            ;;
        clear)
            need_root; > "$GEOIP_CACHE"
            echo -e "${B_GREEN}✓ Кеш очищен${NC}"
            ;;
        *) echo "antiscanner geoip {lookup <ip>|cache|clear}";;
    esac
}

# =============== Защита от самоблокировки ===============
collect_protected_ips() {
    {
        [ -n "${SSH_CLIENT:-}" ] && awk '{print $1}' <<< "$SSH_CLIENT"
        ss -tnH state established 2>/dev/null | awk '$4 ~ /:22$|:22[0-9]+$/ {print $5}' \
            | sed 's/$$//; s/$$.*//; s/:[0-9]*$//' | grep -v '^$' || true
        ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
        ip -6 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
        [ -f "$WHITELIST" ] && grep -vE '^\s*(#|$)' "$WHITELIST" | awk '{print $1}'
    } | sort -u | grep -v '^$'
}

ip_in_cidr() {
    python3 - "$1" "$2" 2>/dev/null <<'PY'
import sys, ipaddress
try:
    sys.exit(0 if ipaddress.ip_address(sys.argv[1]) in ipaddress.ip_network(sys.argv[2], strict=False) else 1)
except: sys.exit(2)
PY
}

is_whitelisted() {
    local ip="$1" cidr
    [ -f "$WHITELIST" ] && while IFS= read -r wl; do
        wl=$(echo "$wl" | xargs)
        [[ -z "$wl" || "$wl" == "#"* ]] && continue
        cidr="$wl"
        if [[ ! "$wl" =~ / ]]; then
            [[ "$wl" =~ : ]] && cidr="${wl}/128" || cidr="${wl}/32"
        fi
        ip_in_cidr "$ip" "$cidr" && return 0
    done < "$WHITELIST"
    while IFS= read -r own; do
        [ "$ip" = "$own" ] && return 0
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    return 1
}

# =============== UPDATE ===============
cmd_update() {
    need_root
    local tmp filtered
    tmp=$(mktemp); filtered=$(mktemp)
    trap "rm -f '$tmp' '$filtered'" RETURN
    log_info "Скачивание..."
    curl -sSL --fail --max-time 60 --connect-timeout 10 \
         --retry 5 --retry-delay 3 --retry-all-errors \
         "$BLOCKLIST_URL" -o "$tmp" || { log_error "Не скачалось"; return 1; }
    [ ! -s "$tmp" ] && { log_error "Пустой"; return 1; }
    sed -i 's/\r$//' "$tmp"
    collect_protected_ips > "$PROTECTED_FILE"
    local excluded=0
    while IFS= read -r line; do
        line=$(echo "$line" | xargs)
        [[ -z "$line" || "$line" == "#"* ]] && continue
        local cidr="$line"
        [[ ! "$line" =~ / ]] && { [[ "$line" =~ : ]] && cidr="${line}/128" || cidr="${line}/32"; }
        local skip=0
        while IFS= read -r pip; do
            [ -z "$pip" ] && continue
            if ip_in_cidr "$pip" "$cidr"; then
                log_warn "ИСКЛ: $line ← $pip"
                skip=1; excluded=$((excluded+1)); break
            fi
        done < "$PROTECTED_FILE"
        [ $skip -eq 0 ] && echo "$line" >> "$filtered"
    done < "$tmp"
    [ -f "$CURRENT" ] && cp "$CURRENT" "$PREVIOUS"
    cp "$filtered" "$CURRENT"
    local added removed n_a n_r
    added=$(comm -23 <(sort -u "$CURRENT") <(sort -u "$PREVIOUS" 2>/dev/null || true))
    removed=$(comm -13 <(sort -u "$CURRENT") <(sort -u "$PREVIOUS" 2>/dev/null || true))
    n_a=$(printf '%s\n' "$added" | grep -c . || true); n_a=${n_a:-0}
    n_r=$(printf '%s\n' "$removed" | grep -c . || true); n_r=${n_r:-0}
    {
        echo "# diff $(log_ts) | +$n_a / -$n_r"
        echo "## ADDED ($n_a):"; printf '%s\n' "$added"
        echo "## REMOVED ($n_r):"; printf '%s\n' "$removed"
    } > "$LAST_DIFF"
    local mode; mode=$(detect_mode)
    log_info "Применение через $mode..."
    [ "$mode" = "ufw" ] && apply_ufw "$filtered" || apply_ipt "$filtered"
    log_info "+$n_a / -$n_r | всего: $(wc -l <"$CURRENT") | исключено: $excluded"
}

apply_ufw() {
    local ok=0 fail=0 num
    while IFS= read -r line; do
        num=$(echo "$line" | grep -oE '^$$\s*[0-9]+$$' | tr -d '[] ')
        [ -n "$num" ] && ufw --force delete "$num" >/dev/null 2>&1
    done < <(ufw status numbered 2>/dev/null | grep 'AntiScanner-Block' | tac)
    while IFS= read -r s || [[ -n "$s" ]]; do
        s=$(echo "$s" | xargs)
        [[ -z "$s" || "$s" == "#"* ]] && continue
        if [[ "$s" =~ \. || "$s" =~ : ]]; then
            ufw insert 1 deny log from "$s" comment 'AntiScanner-Block' >/dev/null 2>&1 && ok=$((ok+1)) || fail=$((fail+1))
        fi
    done < "$1"
    log_info "UFW: ok=$ok fail=$fail"
    ufw reload >/dev/null 2>&1 || true
}

apply_ipt() {
    for c in iptables ip6tables; do
        $c -L "$IPT_CHAIN" -n &>/dev/null || $c -N "$IPT_CHAIN"
        $c -F "$IPT_CHAIN"
        $c -C INPUT -j "$IPT_CHAIN" &>/dev/null || $c -I INPUT 1 -j "$IPT_CHAIN"
    done
    local c
    while IFS= read -r s || [[ -n "$s" ]]; do
        s=$(echo "$s" | xargs)
        [[ -z "$s" || "$s" == "#"* ]] && continue
        c=iptables
        [[ "$s" =~ : ]] && c=ip6tables
        [[ ! "$s" =~ \. && ! "$s" =~ : ]] && continue
        $c -A "$IPT_CHAIN" -s "$s" -m limit --limit 5/min -j LOG --log-prefix "ANTISCANNER-BLOCK: " --log-level 4 2>/dev/null
        $c -A "$IPT_CHAIN" -s "$s" -j DROP 2>/dev/null
    done < "$1"
    mkdir -p /etc/iptables
    iptables-save > /etc/iptables/rules.v4
    ip6tables-save > /etc/iptables/rules.v6
}

# =============== WATCH ===============
cmd_watch() {
    [ ! -f "$LOG_BLOCKED" ] && exit 0
    local last_pos=0
    [ -f "$WATCH_STATE" ] && last_pos=$(cat "$WATCH_STATE" 2>/dev/null || echo 0)
    local cur_size; cur_size=$(stat -c %s "$LOG_BLOCKED" 2>/dev/null || echo 0)
    [ "$cur_size" -lt "$last_pos" ] && last_pos=0
    local now; now=$(date +%s)
    local window_start=$((now - ALERT_WINDOW))
    local new_data; new_data=$(tail -c +$((last_pos+1)) "$LOG_BLOCKED" 2>/dev/null || true)
    echo "$cur_size" > "$WATCH_STATE"
    [ -z "$new_data" ] && exit 0

    local tmp; tmp=$(mktemp); trap "rm -f '$tmp'" EXIT
    echo "$new_data" | while IFS= read -r line; do
        local ts_str ts src dpt
        ts_str=$(echo "$line" | awk '{print $1,$2,$3}')
        ts=$(date -d "$ts_str" +%s 2>/dev/null || echo 0)
        [ "$ts" -lt "$window_start" ] && continue
        src=$(echo "$line" | grep -oE 'SRC=[^ ]+' | cut -d= -f2)
        dpt=$(echo "$line" | grep -oE 'DPT=[0-9]+' | cut -d= -f2)
        [ -n "$src" ] && echo "$src $dpt" >> "$tmp"
    done
    [ ! -s "$tmp" ] && exit 0

    local alerts=""
    touch "$ALERTS_SEEN"
    while read -r cnt ip; do
        [ "$cnt" -lt "$ALERT_THRESHOLD" ] && continue
        local seen_ts; seen_ts=$(grep "^$ip " "$ALERTS_SEEN" 2>/dev/null | awk '{print $2}' || echo 0)
        seen_ts=${seen_ts:-0}
        [ $((now - seen_ts)) -lt "$ALERT_COOLDOWN" ] && continue
        local ports cc fl
        ports=$(grep "^$ip " "$tmp" | awk '{print $2}' | sort -u | tr '\n' ',' | sed 's/,$//')
        cc=$(geoip_lookup "$ip")
        fl=$(flag_emoji "$cc")
        alerts="${alerts}⚠️ ${fl} <code>${ip}</code> (${cc}) — <b>${cnt}</b> попыток / ${ALERT_WINDOW}с (порты: ${ports})"$'\n'
        grep -v "^$ip " "$ALERTS_SEEN" 2>/dev/null > "$ALERTS_SEEN.tmp" || true
        echo "$ip $now" >> "$ALERTS_SEEN.tmp"
        mv "$ALERTS_SEEN.tmp" "$ALERTS_SEEN"
    done < <(awk '{print $1}' "$tmp" | sort | uniq -c | sort -rn)

    if [ -n "$alerts" ]; then
        local msg="🚨 <b>AntiScanner Alert</b>
🖥 <code>$(hostname -s)</code> • $(date '+%H:%M:%S')

${alerts}
<i>Порог: ${ALERT_THRESHOLD} попыток / ${ALERT_WINDOW}с</i>"
        echo "[$(log_ts)] ALERT: отправка..."
        notify "alerts" "$msg" && echo "[$(log_ts)] OK" || echo "[$(log_ts)] TG fail"
    fi
}

# =============== FAIL2BAN ===============
ensure_f2b_infra() {
    ipset list "$IPSET_F2B" &>/dev/null || ipset create "$IPSET_F2B" hash:ip timeout "$F2B_BAN_SECONDS" maxelem 65536
    iptables -C INPUT -m set --match-set "$IPSET_F2B" src -j DROP 2>/dev/null || \
        iptables -I INPUT 1 -m set --match-set "$IPSET_F2B" src -j DROP
}

f2b_ban() {
    local ip="$1" reason="${2:-fail2ban}"
    is_whitelisted "$ip" && { log_warn "F2B: $ip whitelist — skip"; return; }
    ensure_f2b_infra
    ipset add "$IPSET_F2B" "$ip" timeout "$F2B_BAN_SECONDS" -exist 2>/dev/null || true
    echo "$ip $(date +%s) $F2B_BAN_SECONDS $reason" >> "$F2B_BANS"
    local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
    log_info "🔒 BAN: $ip ($reason)"
    notify "fail2ban" "🔒 <b>Fail2ban</b>
${fl} <code>${ip}</code> (${cc})
Забанен на $((F2B_BAN_SECONDS/3600))ч
Причина: ${reason}
🖥 $(hostname -s)" || true
}

cmd_fail2ban() {
    local action="${1:-status}"
    case "$action" in
        run)
            need_root
            ensure_f2b_infra
            log_info "F2B watcher started (max=$F2B_MAX_FAILS, window=${F2B_WINDOW}s)"
            declare -A FAIL_COUNT FAIL_FIRST
            journalctl -u ssh -u sshd -f -n 0 --output=short-iso 2>/dev/null | \
            while IFS= read -r line; do
                local ip; ip=$(echo "$line" | grep -oE '(Failed password|Invalid user|authenticating user).*from [0-9a-fA-F:.]+' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[0-9a-fA-F:]+' | tail -1)
                [ -z "$ip" ] && continue
                is_whitelisted "$ip" && continue
                local now; now=$(date +%s)
                local first="${FAIL_FIRST[$ip]:-0}"
                if [ $((now - first)) -gt "$F2B_WINDOW" ]; then
                    FAIL_COUNT[$ip]=1; FAIL_FIRST[$ip]=$now
                else
                    FAIL_COUNT[$ip]=$((${FAIL_COUNT[$ip]:-0} + 1))
                fi
                local cnt="${FAIL_COUNT[$ip]}"
                log_info "SSH fail: $ip (${cnt}/${F2B_MAX_FAILS})"
                if [ "$cnt" -ge "$F2B_MAX_FAILS" ]; then
                    f2b_ban "$ip" "SSH brute-force ${cnt} попыток"
                    unset FAIL_COUNT[$ip]; unset FAIL_FIRST[$ip]
                fi
            done
            ;;
        unban-expired)
            need_root
            [ ! -f "$F2B_BANS" ] && return
            local now; now=$(date +%s)
            local new; new=$(mktemp)
            while IFS=' ' read -r ip ts secs reason; do
                [ -z "$ip" ] && continue
                if [ $((ts + secs)) -gt "$now" ]; then
                    echo "$ip $ts $secs $reason" >> "$new"
                else
                    log_info "🔓 UNBAN (истёк): $ip"
                    ipset del "$IPSET_F2B" "$ip" 2>/dev/null || true
                fi
            done < "$F2B_BANS"
            mv "$new" "$F2B_BANS"
            ;;
        list)
            echo -e "${B_CYAN}═══ Fail2ban активные ═══${NC}"
            if ipset list "$IPSET_F2B" &>/dev/null; then
                ipset list "$IPSET_F2B" | grep -E '^[0-9]' | head -50 | while read -r ip rest; do
                    local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
                    printf "  %s  %s  %s\n" "$fl" "$ip" "$rest"
                done
            else
                echo -e "${DIM}ipset не создан${NC}"
            fi
            ;;
        unban)
            need_root
            local ip="${2:-}"
            [ -z "$ip" ] && { echo "fail2ban unban <ip>"; return 1; }
            ipset del "$IPSET_F2B" "$ip" 2>/dev/null && echo -e "${B_GREEN}✓ Unban: $ip${NC}" || echo -e "${B_YELLOW}Не найден${NC}"
            grep -v "^$ip " "$F2B_BANS" > "$F2B_BANS.tmp" 2>/dev/null; mv "$F2B_BANS.tmp" "$F2B_BANS" 2>/dev/null || true
            ;;
        silent|quiet)
            need_root
            if grep -q '^NOTIFY_FAIL2BAN=' "$CONFIG" 2>/dev/null; then
                sed -i 's/^NOTIFY_FAIL2BAN=.*/NOTIFY_FAIL2BAN=false/' "$CONFIG"
            else
                echo 'NOTIFY_FAIL2BAN=false' >> "$CONFIG"
            fi
            echo -e "${B_GREEN}✓ Fail2ban работает, без уведомлений${NC}"
            ;;
        verbose|notify)
            need_root
            if grep -q '^NOTIFY_FAIL2BAN=' "$CONFIG" 2>/dev/null; then
                sed -i 's/^NOTIFY_FAIL2BAN=.*/NOTIFY_FAIL2BAN=true/' "$CONFIG"
            else
                echo 'NOTIFY_FAIL2BAN=true' >> "$CONFIG"
            fi
            echo -e "${B_GREEN}✓ Уведомления о fail2ban включены${NC}"
            ;;
        disable|off|stop)
            need_root
            systemctl stop antiscanner-fail2ban 2>/dev/null || true
            systemctl disable antiscanner-fail2ban 2>/dev/null || true
            echo -e "${B_GREEN}✓ Fail2ban отключён${NC}"
            ;;
        enable|on|start)
            need_root
            ensure_f2b_infra
            systemctl enable --now antiscanner-fail2ban.service
            echo -e "${B_GREEN}✓ Fail2ban включён${NC}"
            ;;
        status|*)
            if systemctl is-active --quiet antiscanner-fail2ban; then
                echo -e "${B_GREEN}✓ Fail2ban running${NC}"
            else
                echo -e "${B_RED}✗ Fail2ban stopped${NC}"
            fi
            local cnt=0
            ipset list "$IPSET_F2B" &>/dev/null && cnt=$(ipset list "$IPSET_F2B" | grep -cE '^[0-9]' || true)
            echo -e "Забанено: ${B_YELLOW}${cnt:-0}${NC}"
            echo -e "Порог: ${F2B_MAX_FAILS} fails / ${F2B_WINDOW}s → ban ${F2B_BAN_SECONDS}s"
            echo -e "Уведомления: $([ "${NOTIFY_FAIL2BAN:-false}" = "true" ] && echo "${B_GREEN}on${NC}" || echo "${DIM}off${NC}")"
            ;;
    esac
}

# =============== HONEYPOT ===============
ensure_hp_infra() {
    ipset list "$IPSET_HP" &>/dev/null || ipset create "$IPSET_HP" hash:ip timeout 86400 maxelem 65536
    iptables -C INPUT -m set --match-set "$IPSET_HP" src -j DROP 2>/dev/null || \
        iptables -I INPUT 1 -m set --match-set "$IPSET_HP" src -j DROP
}

hp_listener() {
    local port="$1"
    local NC_BIN
    NC_BIN=$(detect_nc_bin)
    if [ -z "$NC_BIN" ]; then
        log_error "HP: не найден traditional nc — порт $port не работает"
        log_error "Fix: sudo apt-get install netcat-traditional"
        sleep 60
        return 1
    fi

    touch "$LOG_HP" 2>/dev/null
    chmod 644 "$LOG_HP" 2>/dev/null

    while true; do
        "$NC_BIN" -l -n -p "$port" -w 1 </dev/null >/dev/null 2>&1 || true
        local ip
        ip=$(ss -tn state close-wait "dport = :$port" 2>/dev/null | awk 'NR>1{print $5}' | cut -d: -f1 | head -1)
        [ -z "$ip" ] && ip=$(ss -tn "sport = :$port" 2>/dev/null | awk 'NR>1{print $5}' | cut -d: -f1 | head -1)
        if [ -n "$ip" ]; then
            if is_whitelisted "$ip"; then
                log_warn "HP hit $ip:$port — whitelist"
            else
                echo "$(date '+%b %e %H:%M:%S') $(hostname -s) antiscanner: HONEYPOT-HIT: SRC=$ip DPT=$port PROTO=TCP" >> "$LOG_HP"
                logger -t antiscanner "HONEYPOT-HIT: SRC=$ip DPT=$port" 2>/dev/null || true
                ipset add "$IPSET_HP" "$ip" timeout 86400 -exist 2>/dev/null || true
                local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
                log_info "🕷 HONEYPOT: $ip → port $port → BANNED"
                notify "honeypot" "🕷 <b>Honeypot Hit!</b>
${fl} <code>${ip}</code> (${cc}) → port <b>${port}</b>
Забанен на 24ч
🖥 $(hostname -s)" || true
            fi
        fi
        sleep 0.3
    done
}

cmd_honeypot() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root; ensure_hp_infra
            echo "$HONEYPOT_PORTS" > "$CONF_DIR/honeypot.ports"
            log_info "Honeypot настроен на порты: $HONEYPOT_PORTS"
            ;;
        run)
            need_root
            [ -f "$CONF_DIR/honeypot.ports" ] && HONEYPOT_PORTS=$(cat "$CONF_DIR/honeypot.ports")
            ensure_hp_infra
            local NC_BIN; NC_BIN=$(detect_nc_bin)
            if [ -z "$NC_BIN" ]; then
                log_error "nc.traditional не найден — honeypot не запустится"
                log_error "Установите: apt-get install netcat-traditional"
                exit 1
            fi
            log_info "Honeypot listener ($NC_BIN): $HONEYPOT_PORTS"
            local pids=""
            for port in $HONEYPOT_PORTS; do
                hp_listener "$port" &
                pids="$pids $!"
            done
            trap "kill $pids 2>/dev/null" EXIT TERM INT
            wait
            ;;
        remove)
            need_root
            iptables -D INPUT -m set --match-set "$IPSET_HP" src -j DROP 2>/dev/null || true
            ipset destroy "$IPSET_HP" 2>/dev/null || true
            systemctl stop antiscanner-honeypot 2>/dev/null || true
            systemctl disable antiscanner-honeypot 2>/dev/null || true
            echo -e "${B_GREEN}✓ Honeypot отключён${NC}"
            ;;
        disable|off|stop)
            need_root
            systemctl stop antiscanner-honeypot 2>/dev/null || true
            systemctl disable antiscanner-honeypot 2>/dev/null || true
            iptables -D INPUT -m set --match-set "$IPSET_HP" src -j DROP 2>/dev/null || true
            [ -d /etc/iptables ] && iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
            echo -e "${B_GREEN}✓ Honeypot отключён${NC}"
            ;;
        enable|on|start)
            need_root
            ensure_hp_infra
            systemctl enable --now antiscanner-honeypot.service
            echo -e "${B_GREEN}✓ Honeypot включён${NC}"
            ;;
        silent|quiet)
            need_root
            if grep -q '^NOTIFY_HONEYPOT=' "$CONFIG" 2>/dev/null; then
                sed -i 's/^NOTIFY_HONEYPOT=.*/NOTIFY_HONEYPOT=false/' "$CONFIG"
            else
                echo 'NOTIFY_HONEYPOT=false' >> "$CONFIG"
            fi
            echo -e "${B_GREEN}✓ Honeypot работает, но уведомлений больше не будет${NC}"
            ;;
        verbose|notify)
            need_root
            if grep -q '^NOTIFY_HONEYPOT=' "$CONFIG" 2>/dev/null; then
                sed -i 's/^NOTIFY_HONEYPOT=.*/NOTIFY_HONEYPOT=true/' "$CONFIG"
            else
                echo 'NOTIFY_HONEYPOT=true' >> "$CONFIG"
            fi
            echo -e "${B_GREEN}✓ Уведомления о honeypot включены${NC}"
            ;;
        list|bans)
            echo -e "${B_CYAN}═══ Honeypot bans ═══${NC}"
            if ipset list "$IPSET_HP" &>/dev/null; then
                ipset list "$IPSET_HP" | grep -E '^[0-9]' | head -50 | while read -r ip rest; do
                    local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
                    printf "  %s  %s  %s\n" "$fl" "$ip" "$rest"
                done
            else
                echo "(пусто)"
            fi
            ;;
        status|*)
            if systemctl is-active --quiet antiscanner-honeypot; then
                echo -e "${B_GREEN}✓ Honeypot listener running${NC}"
            else
                echo -e "${B_RED}✗ Honeypot listener stopped${NC}"
            fi
            echo -e "Порты: ${B_MAGENTA}${HONEYPOT_PORTS}${NC}"
            local NC_BIN; NC_BIN=$(detect_nc_bin)
            if [ -n "$NC_BIN" ]; then
                echo -e "nc бинарь: ${B_GREEN}${NC_BIN}${NC}"
            else
                echo -e "nc бинарь: ${B_RED}НЕ НАЙДЕН${NC}"
            fi
            local cnt=0
            ipset list "$IPSET_HP" &>/dev/null && cnt=$(ipset list "$IPSET_HP" | grep -cE '^[0-9]' || true)
            echo -e "Забанено: ${B_YELLOW}${cnt:-0}${NC}"
            echo -e "Уведомления: $([ "${NOTIFY_HONEYPOT:-false}" = "true" ] && echo "${B_GREEN}on${NC}" || echo "${DIM}off${NC}")"
            ;;
    esac
}

# =============== RATELIMIT ===============
cmd_ratelimit() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root
            [ "$RATELIMIT_ENABLED" != "true" ] && { echo -e "${B_YELLOW}Выключен в $CONFIG${NC}"; return; }
            for port in $RATELIMIT_PORTS; do
                while iptables -D INPUT -p tcp --dport "$port" -m conntrack --ctstate NEW -m hashlimit \
                    --hashlimit-above "$RATELIMIT_RATE" --hashlimit-burst "$RATELIMIT_BURST" \
                    --hashlimit-mode srcip --hashlimit-name "rl-$port" -j DROP 2>/dev/null; do :; done
                iptables -I INPUT -p tcp --dport "$port" -m conntrack --ctstate NEW \
                    -m hashlimit --hashlimit-above "$RATELIMIT_RATE" \
                    --hashlimit-burst "$RATELIMIT_BURST" \
                    --hashlimit-mode srcip --hashlimit-name "rl-$port" \
                    -m comment --comment "AntiScanner-RateLimit" -j DROP
                log_info "Rate-limit port $port: $RATELIMIT_RATE (burst $RATELIMIT_BURST)"
            done
            mkdir -p /etc/iptables && iptables-save > /etc/iptables/rules.v4
            ;;
        remove)
            need_root
            local rl_rules=""
            rl_rules=$(iptables-save 2>/dev/null | grep 'AntiScanner-RateLimit' || true)
            if [ -n "$rl_rules" ]; then
                echo "$rl_rules" | sed 's/^-A /-D /' | while read -r rule; do
                    eval "iptables $rule" 2>/dev/null || true
                done
            fi
            iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
            echo -e "${B_GREEN}✓ Rate-limit удалён${NC}"
            ;;
        status|*)
            echo -e "${B_CYAN}═══ Rate-limit ═══${NC}"
            local rules; rules=$(iptables-save 2>/dev/null | grep -c 'AntiScanner-RateLimit' || true); rules=${rules:-0}
            if [ "$rules" -gt 0 ]; then
                echo -e "${B_GREEN}✓ Активен${NC} (правил: $rules)"
                iptables-save 2>/dev/null | grep 'AntiScanner-RateLimit'
            else
                echo -e "${B_RED}✗ Не активен${NC}"
            fi
            ;;
    esac
}

# =============== STATUS ===============
count_rules() {
    local m=$1
    if [ "$m" = "ufw" ]; then
        local s; s=$(ufw status numbered 2>/dev/null || true)
        IPV4=$(echo "$s" | grep 'AntiScanner-Block' | grep -vc '(v6)' || true)
        IPV6=$(echo "$s" | grep 'AntiScanner-Block' | grep -c  '(v6)' || true)
    else
        IPV4=$(iptables  -S "$IPT_CHAIN" 2>/dev/null | grep -c '^-A .* -j DROP' || true)
        IPV6=$(ip6tables -S "$IPT_CHAIN" 2>/dev/null | grep -c '^-A .* -j DROP' || true)
    fi
    IPV4=${IPV4:-0}; IPV6=${IPV6:-0}
}

color_n() {
    local n=$1
    [ "$n" -eq 0 ] && { echo -e "${B_RED}${n}${NC}"; return; }
    [ "$n" -lt 50 ] && { echo -e "${B_YELLOW}${n}${NC}"; return; }
    echo -e "${B_GREEN}${n}${NC}"
}

pad_v() {
    local raw="$1" width="$2"
    local stripped
    stripped=$(echo -e "$raw" | sed -E 's/\x1B$$[0-9;]*[mK]//g')
    local len
    len=$(python3 -c 'import sys; print(len(sys.argv[1]))' "$stripped" 2>/dev/null || echo "${#stripped}")
    local pad=$((width - len))
    (( pad < 0 )) && pad=0
    printf "%b%*s" "$raw" "$pad" ""
}

cmd_status() {
    local mode; mode=$(detect_mode)
    count_rules "$mode"
    local total=$((IPV4 + IPV6))
    local st_c st_t
    [ "$total" -gt 0 ] && { st_c="$B_GREEN"; st_t="АКТИВЕН"; } || { st_c="$B_RED"; st_t="НЕТ ПРАВИЛ"; }
    local f2b_cnt=0 hp_cnt=0
    ipset list "$IPSET_F2B" &>/dev/null && f2b_cnt=$(ipset list "$IPSET_F2B" | grep -cE '^[0-9]' || true)
    ipset list "$IPSET_HP"  &>/dev/null && hp_cnt=$(ipset list "$IPSET_HP"  | grep -cE '^[0-9]' || true)
    f2b_cnt=${f2b_cnt:-0}; hp_cnt=${hp_cnt:-0}
    local blocked_today=0 hp_today=0
    [ -f "$LOG_BLOCKED" ] && { blocked_today=$(grep -c "$(date '+%b %e')" "$LOG_BLOCKED" 2>/dev/null || true); blocked_today=${blocked_today:-0}; }
    [ -f "$LOG_HP" ] && { hp_today=$(grep -c "$(date '+%b %e')" "$LOG_HP" 2>/dev/null || true); hp_today=${hp_today:-0}; }
    local wl_c=0
    [ -f "$WHITELIST" ] && { wl_c=$(grep -cvE '^\s*(#|$)' "$WHITELIST" 2>/dev/null || true); wl_c=${wl_c:-0}; }
    local tg_st="${DIM}нет${NC}"; [ -f "$TG_CONF" ] && tg_st="${B_GREEN}OK${NC}"
    local f2b_st="${DIM}off${NC}"; systemctl is-active --quiet antiscanner-fail2ban 2>/dev/null && f2b_st="${B_GREEN}running${NC}"
    local hp_st="${DIM}off${NC}"; systemctl is-active --quiet antiscanner-honeypot 2>/dev/null && hp_st="${B_GREEN}running${NC}"
    local rl_st="${DIM}off${NC}"; iptables-save 2>/dev/null | grep -q 'AntiScanner-RateLimit' && rl_st="${B_GREEN}active${NC}"
    local geo_cnt=0; [ -f "$GEOIP_CACHE" ] && geo_cnt=$(wc -l <"$GEOIP_CACHE" 2>/dev/null || echo 0)

    _row() { echo -e "${B_CYAN}║${NC} $(pad_v "$1" 26) ${B_CYAN}║${NC} $(pad_v "$2" 27)${B_CYAN}║${NC}"; }

    echo
    echo -e "${B_CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${B_CYAN}║${B_WHITE}       ANTISCANNER v3.3.3 — полный статус                  ${B_CYAN}║${NC}"
    echo -e "${B_CYAN}╠════════════════════════════╦═════════════════════════════╣${NC}"
    _row "Режим фаервола"            "${B_MAGENTA}${mode^^}${NC}"
    _row "Блоклист статус"           "${st_c}${st_t}${NC}"
    echo -e "${B_CYAN}╠════════════════════════════╬═════════════════════════════╣${NC}"
    _row "${B_BLUE}Блоклист IPv4${NC}"       "$(color_n "$IPV4") правил"
    _row "${B_BLUE}Блоклист IPv6${NC}"       "$(color_n "$IPV6") правил"
    _row "${B_WHITE}ВСЕГО блоклист${NC}"     "${B_GREEN}${BOLD}${total}${NC} правил"
    echo -e "${B_CYAN}╠════════════════════════════╬═════════════════════════════╣${NC}"
    _row "Fail2ban"                  "$f2b_st ($(color_n "$f2b_cnt"))"
    _row "Honeypot"                  "$hp_st ($(color_n "$hp_cnt"))"
    _row "Rate-limit"                "$rl_st"
    echo -e "${B_CYAN}╠════════════════════════════╬═════════════════════════════╣${NC}"
    _row "Whitelist"                 "${B_CYAN}${wl_c}${NC} записей"
    _row "Атак сегодня (blocked)"    "${B_YELLOW}${blocked_today}${NC}"
    _row "Атак сегодня (honeypot)"   "${B_YELLOW}${hp_today}${NC}"
    _row "GeoIP кеш"                 "${DIM}${geo_cnt} IP${NC}"
    _row "Telegram"                  "$tg_st"
    echo -e "${B_CYAN}╚════════════════════════════╩═════════════════════════════╝${NC}"
    echo
}

# =============== DIFF ===============
cmd_diff() {
    [ ! -f "$LAST_DIFF" ] && { echo "Нет диффа"; return; }
    echo -e "${B_CYAN}═══ Последний дифф ═══${NC}"
    head -1 "$LAST_DIFF"
    awk '/^## ADDED/{f=1;next} /^## REMOVED/{f=0} f && NF' "$LAST_DIFF" | head -20 | while read -r l; do echo -e "  ${B_GREEN}+${NC} $l"; done
    awk '/^## REMOVED/{f=1;next} f && NF' "$LAST_DIFF" | head -20 | while read -r l; do echo -e "  ${B_RED}-${NC} $l"; done
}

# =============== REPORT ===============
cmd_report() {
    local since force_flag=""
    case "${1:-}" in
        --24h|-d)  since=$(date -d '24 hours ago' +%s); force_flag="1" ;;
        --7d|-w)   since=$(date -d '7 days ago' +%s);   force_flag="1" ;;
        --all|-a)  since=0; force_flag="1" ;;
        *)         since=$(cat "$REPORT_STATE" 2>/dev/null || date -d '24 hours ago' +%s) ;;
    esac

    local mode; mode=$(detect_mode); count_rules "$mode"; local total=$((IPV4+IPV6))
    local all_ips=$(mktemp) all_ports=$(mktemp)
    trap "rm -f '$all_ips' '$all_ports'" RETURN

    local bl_count=0
    if [ -s "$LOG_BLOCKED" ]; then
        local f; f=$(mktemp)
        awk -v s="$since" '{c="date -d \""$1" "$2" "$3"\" +%s 2>/dev/null";c|getline t;close(c);if(t>=s)print}' "$LOG_BLOCKED" > "$f" 2>/dev/null
        bl_count=$(wc -l <"$f")
        grep -oE 'SRC=[^ ]+' "$f" | cut -d= -f2 >> "$all_ips"
        grep -oE 'DPT=[0-9]+' "$f" | cut -d= -f2 >> "$all_ports"
        rm -f "$f"
    fi

    local hp_count=0
    if [ -s "$LOG_HP" ]; then
        local f; f=$(mktemp)
        awk -v s="$since" '{c="date -d \""$1" "$2" "$3"\" +%s 2>/dev/null";c|getline t;close(c);if(t>=s)print}' "$LOG_HP" > "$f" 2>/dev/null
        hp_count=$(wc -l <"$f")
        grep -oE 'SRC=[^ ]+' "$f" | cut -d= -f2 >> "$all_ips"
        grep -oE 'DPT=[0-9]+' "$f" | cut -d= -f2 >> "$all_ports"
        rm -f "$f"
    fi

    local f2b_new=0
    [ -f "$F2B_BANS" ] && f2b_new=$(awk -v s="$since" '$2 >= s' "$F2B_BANS" 2>/dev/null | wc -l || echo 0)
    local total_attempts=$((bl_count + hp_count))
    local unique; unique=$(sort -u "$all_ips" 2>/dev/null | wc -l || echo 0)
    local f2b_cnt=0 hp_bans=0
    ipset list "$IPSET_F2B" &>/dev/null && f2b_cnt=$(ipset list "$IPSET_F2B"|grep -cE '^[0-9]' || true)
    ipset list "$IPSET_HP"  &>/dev/null && hp_bans=$(ipset list "$IPSET_HP"|grep -cE '^[0-9]' || true)
    f2b_cnt=${f2b_cnt:-0}; hp_bans=${hp_bans:-0}

    local top_lines=""
    if [ -s "$all_ips" ]; then
        echo -e "${B_YELLOW}GeoIP lookup...${NC}" >&2
        local top_raw; top_raw=$(sort "$all_ips" | uniq -c | sort -rn | head -10)
        while read -r cnt ip; do
            [ -z "$ip" ] && continue
            local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
            top_lines="${top_lines}${fl} $(printf '%4d' "$cnt") × ${ip} (${cc})
"
        done <<< "$top_raw"
    fi

    local top_countries=""
    if [ -s "$all_ips" ]; then
        local cfile; cfile=$(mktemp)
        sort -u "$all_ips" | while read -r ip; do
            [ -n "$ip" ] && echo "$(geoip_lookup "$ip")" >> "$cfile"
        done
        top_countries=$(sort "$cfile" | uniq -c | sort -rn | head -5)
        rm -f "$cfile"
    fi

    local top_ports=""
    [ -s "$all_ports" ] && top_ports=$(sort "$all_ports" | uniq -c | sort -rn | head -5)

    local since_h
    [ "$since" = "0" ] && since_h="все записи" || since_h=$(date -d "@$since" '+%Y-%m-%d %H:%M')

    local msg="🛡 <b>AntiScanner Daily Report</b>
🖥 <code>$(hostname -s)</code> • 📅 $(date '+%Y-%m-%d %H:%M')
📊 Период: с <i>${since_h}</i>

<b>━━ Защита ━━</b>
├ Режим: <b>${mode^^}</b>
├ Блоклист: <b>${total}</b> (v4:${IPV4} v6:${IPV6})
├ Fail2ban активных: <b>${f2b_cnt}</b>
└ Honeypot активных: <b>${hp_bans}</b>

<b>━━ Атаки за период ━━</b>
├ Блоклист сработал: <b>${bl_count}</b>
├ Honeypot поймал: <b>${hp_count}</b>
├ Fail2ban забанил: <b>${f2b_new}</b>
├ <b>ВСЕГО попыток: ${total_attempts}</b>
└ Уникальных IP: <b>${unique}</b>"

    if [ -n "$top_lines" ]; then
        msg="${msg}

🔥 <b>TOP-10 атакующих:</b>
<pre>${top_lines}</pre>"
    fi

    if [ -n "$top_countries" ]; then
        msg="${msg}

🌍 <b>TOP стран:</b>
<pre>"
        while read -r cnt cc; do
            [ -z "$cc" ] && continue
            local fl; fl=$(flag_emoji "$cc")
            msg="${msg}
${fl} ${cc} — ${cnt} IP"
        done <<< "$top_countries"
        msg="${msg}
</pre>"
    fi

    if [ -n "$top_ports" ]; then
        msg="${msg}

🎯 <b>TOP атакуемых портов:</b>
<pre>$(echo "$top_ports" | awk '{printf "%5s × port %s\n",$1,$2}')</pre>"
    fi

    echo "$msg" | sed -E 's|</?[a-z][^>]*>||g'
    if notify "report" "$msg"; then
        echo -e "${B_GREEN}✓ Отправлено${NC}"
    else
        echo -e "${B_RED}✗ TG fail (или NOTIFY_REPORT=false)${NC}"
    fi
    [ -z "$force_flag" ] && date +%s > "$REPORT_STATE"
}

# =============== LOGS ===============
cmd_logs() {
    local what="${1:-update}"
    case "$what" in
        update)   tail -30 "$LOG_UPDATE" 2>/dev/null || echo "(пусто)" ;;
        blocked)  tail -30 "$LOG_BLOCKED" 2>/dev/null || echo "(пусто)" ;;
        alerts)   tail -30 "$LOG_ALERTS" 2>/dev/null || echo "(пусто)" ;;
        f2b|fail2ban) tail -30 "$LOG_F2B" 2>/dev/null || echo "(пусто)" ;;
        honeypot|hp) tail -30 "$LOG_HP" 2>/dev/null || echo "(пусто)" ;;
        *) echo "logs {update|blocked|alerts|f2b|honeypot}" ;;
    esac
}

# =============== WHITELIST ===============
cmd_whitelist() {
    local a="${1:-list}" ip="${2:-}"
    case "$a" in
        list) grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | nl -ba || echo "(пусто)" ;;
        add)  need_root; [ -z "$ip" ] && { echo "whitelist add <ip>"; return; }
              grep -qxF "$ip" "$WHITELIST" 2>/dev/null && { echo "уже есть"; return; }
              echo "$ip" >> "$WHITELIST"; echo -e "${B_GREEN}✓${NC} $ip" ;;
        del)  need_root; [ -z "$ip" ] && { echo "whitelist del <ip>"; return; }
              sed -i "\|^${ip}\s*\$|d" "$WHITELIST"; echo -e "${B_GREEN}✓${NC} удалён" ;;
    esac
}

# =============== TEST ===============
test_result() {
    case "$1" in
        ok)   echo -e "  ${B_GREEN}✓${NC} $2 ${DIM}${3:-}${NC}" ;;
        fail) echo -e "  ${B_RED}✗${NC} $2 ${B_YELLOW}${3:-}${NC}" ;;
        warn) echo -e "  ${B_YELLOW}⚠${NC} $2 ${DIM}${3:-}${NC}" ;;
        info) echo -e "  ${B_BLUE}ⓘ${NC} $2 ${DIM}${3:-}${NC}" ;;
    esac
}

cmd_test() {
    echo -e "${B_CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${B_CYAN}║${B_WHITE}         САМОДИАГНОСТИКА ANTISCANNER v3.3.3                ${B_CYAN}║${NC}"
    echo -e "${B_CYAN}╚══════════════════════════════════════════════════════════╝${NC}"

    echo -e "\n${B_WHITE}▶ Операционная система${NC}"
    if [ -f /etc/os-release ]; then
        set +u
        . /etc/os-release
        set -u
        if [ "${ID:-}" = "ubuntu" ] && [[ "${VERSION_ID:-}" =~ ^24 ]]; then
            test_result ok "Ubuntu ${VERSION_ID}" "${PRETTY_NAME:-}"
        elif [ "${ID:-}" = "ubuntu" ]; then
            test_result warn "Ubuntu ${VERSION_ID:-?}" "оптимизировано для 24.04"
        else
            test_result warn "Не Ubuntu" "${ID:-unknown}"
        fi
    else
        test_result fail "/etc/os-release" "не найден"
    fi
    test_result info "Ядро" "$(uname -r)"
    test_result info "Bash" "${BASH_VERSION:-?}"

    echo -e "\n${B_WHITE}▶ Система${NC}"
    [ "$EUID" -eq 0 ] && test_result ok "Запущено от root" || test_result warn "Не root"
    for c in curl python3 iptables ipset ss awk sed grep; do
        command -v "$c" >/dev/null 2>&1 && test_result ok "$c" "$(command -v $c)" || test_result fail "$c" "не найден"
    done

    echo -e "\n${B_WHITE}▶ Netcat (критично для honeypot)${NC}"
    local NC_BIN; NC_BIN=$(detect_nc_bin)
    if [ -n "$NC_BIN" ]; then
        test_result ok "nc.traditional" "$NC_BIN"
    else
        test_result fail "netcat-traditional не найден" "honeypot работать НЕ БУДЕТ"
        test_result info "Fix" "sudo apt-get install netcat-traditional"
    fi
    if command -v nc >/dev/null 2>&1; then
        if nc -h 2>&1 | grep -qi 'OpenBSD netcat'; then
            test_result warn "Default nc" "OpenBSD"
            test_result info "Honeypot" "использует прямой путь $NC_BIN"
        else
            test_result ok "Default nc" "traditional"
        fi
    fi

    echo -e "\n${B_WHITE}▶ Сеть${NC}"
    ping -c1 -W2 8.8.8.8 >/dev/null 2>&1 && test_result ok "ICMP до 8.8.8.8" || test_result warn "ICMP" "нет iputils-ping?"
    getent hosts api.telegram.org >/dev/null 2>&1 && test_result ok "DNS api.telegram.org" || test_result fail "DNS api.telegram.org"
    local http_code
    http_code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 20 --retry 2 --retry-delay 3 "$BLOCKLIST_URL" 2>/dev/null || echo "000")
    case "$http_code" in
        200) test_result ok "Блоклист доступен" "HTTP 200" ;;
        000) test_result warn "Блоклист" "timeout/DPI" ;;
        *)   test_result warn "Блоклист" "HTTP $http_code" ;;
    esac

    echo -e "\n${B_WHITE}▶ Файлы${NC}"
    for f in "$CONFIG" "$WHITELIST" "$CURRENT" "$LOG_UPDATE" "$LOG_BLOCKED" "$LOG_HP"; do
        [ -f "$f" ] && test_result ok "$f" || test_result warn "$f" "нет"
    done

    echo -e "\n${B_WHITE}▶ Фаервол${NC}"
    local mode; mode=$(detect_mode); test_result info "Режим" "$mode"
    if iptables --version 2>/dev/null | grep -qi 'nf_tables'; then
        test_result info "iptables backend" "nf_tables (Ubuntu 24 default)"
    elif iptables --version 2>/dev/null | grep -qi 'legacy'; then
        test_result info "iptables backend" "legacy"
    fi
    count_rules "$mode"
    [ "$((IPV4+IPV6))" -gt 0 ] && test_result ok "Блоклист" "IPv4=$IPV4 IPv6=$IPV6" || test_result warn "Блоклист" "0 правил"

    echo -e "\n${B_WHITE}▶ Fail2ban${NC}"
    ipset list "$IPSET_F2B" &>/dev/null && test_result ok "ipset $IPSET_F2B" || test_result warn "ipset $IPSET_F2B"
    systemctl is-active --quiet antiscanner-fail2ban && test_result ok "Служба" "running" || test_result warn "Служба" "stopped"
    iptables -C INPUT -m set --match-set "$IPSET_F2B" src -j DROP 2>/dev/null && test_result ok "iptables drop" || test_result warn "iptables drop"
    test_result info "NOTIFY_FAIL2BAN" "${NOTIFY_FAIL2BAN:-false}"

    echo -e "\n${B_WHITE}▶ Honeypot${NC}"
    ipset list "$IPSET_HP" &>/dev/null && test_result ok "ipset $IPSET_HP" || test_result warn "ipset $IPSET_HP"
    if systemctl is-active --quiet antiscanner-honeypot; then
        test_result ok "Listener" "$HONEYPOT_PORTS"
        for p in $HONEYPOT_PORTS; do
            ss -tln "sport = :$p" | grep -q LISTEN && test_result ok "Порт $p" "слушается" || test_result warn "Порт $p"
        done
    else
        test_result warn "Listener" "stopped"
    fi
    local hp_log_size=0
    [ -f "$LOG_HP" ] && hp_log_size=$(wc -l <"$LOG_HP" 2>/dev/null || echo 0)
    [ "$hp_log_size" -gt 0 ] && test_result ok "Лог honeypot" "$hp_log_size записей" || test_result info "Лог honeypot" "пусто"
    test_result info "NOTIFY_HONEYPOT" "${NOTIFY_HONEYPOT:-false}"

    echo -e "\n${B_WHITE}▶ Rate-limit${NC}"
    iptables-save 2>/dev/null | grep -q AntiScanner-RateLimit && test_result ok "Правила активны" || test_result warn "Не активен"

    echo -e "\n${B_WHITE}▶ GeoIP${NC}"
    local geo_cnt=0; [ -f "$GEOIP_CACHE" ] && geo_cnt=$(wc -l <"$GEOIP_CACHE" 2>/dev/null || echo 0)
    test_result info "Кеш" "$geo_cnt IP"
    local test_cc; test_cc=$(geoip_lookup "8.8.8.8" 2>/dev/null)
    [ "$test_cc" = "US" ] && test_result ok "API" "8.8.8.8=US" || test_result warn "API" "ответ: $test_cc"

    echo -e "\n${B_WHITE}▶ Логирование${NC}"
    [ -f /etc/rsyslog.d/10-antiscanner.conf ] && test_result ok "rsyslog config" || test_result fail "rsyslog config"
    systemctl is-active --quiet rsyslog && test_result ok "rsyslog работает" || test_result warn "rsyslog"
    systemctl is-active --quiet cron && test_result ok "cron работает" || test_result warn "cron" "не активен"

    echo -e "\n${B_WHITE}▶ Telegram${NC}"
    if [ -f "$TG_CONF" ]; then
        test_result ok "Конфиг" "$TG_CONF"
        if [ "$EUID" -eq 0 ]; then
            send_telegram "🧪 <b>test</b> с <code>$(hostname -s)</code>" && test_result ok "Отправка" || test_result fail "Отправка"
        fi
    else
        test_result warn "Telegram" "не настроен"
    fi

    echo -e "\n${B_WHITE}▶ Расписание${NC}"
    local cron; cron=$(crontab -l 2>/dev/null | grep -c 'antiscanner' || true); cron=${cron:-0}
    [ "$cron" -gt 0 ] && test_result ok "CRON" "$cron задач" || test_result fail "CRON"
    for s in antiscanner-fail2ban antiscanner-honeypot antiscanner-update antiscanner-unban.timer; do
        systemctl is-enabled --quiet "$s" 2>/dev/null && test_result ok "systemd: $s" "enabled" || test_result info "systemd: $s" "off"
    done

    echo
    echo -e "${B_CYAN}═══ Диагностика завершена ═══${NC}"
}

cmd_notify() {
    local module="${1:-status}" state="${2:-}"
    case "$module" in
        status)
            echo -e "${B_CYAN}═══ Уведомления в Telegram ═══${NC}"
            for m in ALERTS REPORT HONEYPOT FAIL2BAN; do
                local var="NOTIFY_${m}"
                local v="${!var:-true}"
                if [ "$v" = "true" ]; then
                    echo -e "  ${B_GREEN}✓${NC} $m  ${DIM}(включено)${NC}"
                else
                    echo -e "  ${B_RED}✗${NC} $m  ${DIM}(отключено)${NC}"
                fi
            done
            ;;
        alerts|report|honeypot|fail2ban)
            need_root
            [ -z "$state" ] && { echo "antiscanner notify $module {on|off}"; return 1; }
            local var="NOTIFY_${module^^}"
            local val
            case "$state" in
                on|true|enable)   val="true" ;;
                off|false|disable) val="false" ;;
                *) echo "state: on | off"; return 1 ;;
            esac
            if grep -q "^${var}=" "$CONFIG" 2>/dev/null; then
                sed -i "s/^${var}=.*/${var}=${val}/" "$CONFIG"
            else
                echo "${var}=${val}" >> "$CONFIG"
            fi
            echo -e "${B_GREEN}✓${NC} $var = $val"
            ;;
        *) echo "antiscanner notify {status | alerts|report|honeypot|fail2ban on|off}" ;;
    esac
}

cmd_uninstall() {
    need_root
    read -rp "Удалить AntiScanner полностью? [y/N]: " a
    [[ ! "$a" =~ ^[Yy]$ ]] && return
    systemctl disable --now antiscanner-fail2ban antiscanner-honeypot antiscanner-unban.timer antiscanner-update 2>/dev/null || true
    rm -f /etc/systemd/system/antiscanner-*.service /etc/systemd/system/antiscanner-*.timer
    systemctl daemon-reload
    cmd_honeypot remove 2>/dev/null || true
    cmd_ratelimit remove 2>/dev/null || true
    ipset destroy "$IPSET_F2B" 2>/dev/null || true
    ipset destroy "$IPSET_HP" 2>/dev/null || true
    local mode; mode=$(detect_mode)
    if [ "$mode" = "ufw" ]; then
        local ufw_lines=""
        ufw_lines=$(ufw status numbered 2>/dev/null | grep 'AntiScanner' | tac || true)
        if [ -n "$ufw_lines" ]; then
            while IFS= read -r l; do
                local n; n=$(echo "$l" | grep -oE '^\[\s*[0-9]+$$' | tr -d '[] ' || true)
                [ -n "$n" ] && ufw --force delete "$n" >/dev/null 2>&1 || true
            done <<< "$ufw_lines"
        fi
    fi
    for c in iptables ip6tables; do
        $c -D INPUT -j "$IPT_CHAIN" 2>/dev/null || true
        $c -F "$IPT_CHAIN" 2>/dev/null; $c -X "$IPT_CHAIN" 2>/dev/null
    done
    (crontab -l 2>/dev/null | grep -vF 'antiscanner') | crontab - 2>/dev/null || true
    rm -f /etc/rsyslog.d/10-antiscanner.conf /etc/logrotate.d/antiscanner /etc/logrotate.d/antiscanner-report
    systemctl restart rsyslog 2>/dev/null || true
    rm -rf "$CONF_DIR"
    rm -f /var/log/antiscanner_*.log
    rm -f /usr/local/bin/antiscanner /usr/local/bin/antiscanner-report
    echo -e "${B_GREEN}✔ Удалено${NC}"
}

