    diff)            shift; cmd_diff "$@" ;;
    report)          shift; cmd_report "$@" ;;
    watch)           shift; cmd_watch "$@"; SHOW_CHEAT_AT_END=0 ;;
    logs)            shift; cmd_logs "$@"; SHOW_CHEAT_AT_END=0 ;;
    whitelist|wl)    shift; cmd_whitelist "$@" ;;
    telegram|tg)     shift; cmd_telegram "$@" ;;
    fail2ban|f2b)    shift; cmd_fail2ban "$@" ;;
    honeypot|hp)     shift; cmd_honeypot "$@" ;;
    ratelimit|rl)    shift; cmd_ratelimit "$@" ;;
    geoip|geo)       shift; cmd_geoip "$@"; SHOW_CHEAT_AT_END=0 ;;
    notify)          shift; cmd_notify "$@" ;;
