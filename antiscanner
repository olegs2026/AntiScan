#!/bin/bash
# antiscanner v3.3.7 — финальная версия для Ubuntu 22.04/24.04
# Фиксы: cmd_watch (integer expression), санитизация всех числовых переменных
set -u

BOLD='\033[1m'; DIM='\033[2m'
B_CYAN='\033[1;36m'; B_GREEN='\033[1;32m'; B_YELLOW='\033[1;33m'
B_RED='\033[1;31m'; B_MAGENTA='\033[1;35m'; B_BLUE='\033[1;34m'
B_WHITE='\033[1;37m'; NC='\033[0m'

CONF_DIR="/etc/antiscanner"
CONFIG="$CONF_DIR/config.conf"
WHITELIST="$CONF_DIR/whitelist.txt"
WHITELIST_PORTS="$CONF_DIR/whitelist_ports.txt"
CURRENT="$CONF_DIR/current.list"
PREVIOUS="$CONF_DIR/previous.list"
LAST_DIFF="$CONF_DIR/last.diff"
PROTECTED_FILE="$CONF_DIR/protected.list"
TG_CONF="$CONF_DIR/telegram.conf"
REPORT_STATE="$CONF_DIR/report.state"
WATCH_STATE="$CONF_DIR/watch.state"
ALERTS_SEEN="$CONF_DIR/alerts.seen"
F2B_STATE="$CONF_DIR/fail2ban.state"
F2B_BANS="$CONF_DIR/fail2ban.bans"
GEOIP_CACHE="$CONF_DIR/geoip.cache"
LOG_UPDATE="/var/log/antiscanner_update.log"
LOG_BLOCKED="/var/log/antiscanner_blocked.log"
LOG_ALERTS="/var/log/antiscanner_alerts.log"
LOG_F2B="/var/log/antiscanner_fail2ban.log"
LOG_HP="/var/log/antiscanner_honeypot.log"
IPT_CHAIN="SCANNERS-BLOCK"
IPSET_F2B="antiscanner-f2b"
IPSET_HP="antiscanner-honeypot"

# Дефолты
ALERT_THRESHOLD=3
ALERT_WINDOW=300
ALERT_COOLDOWN=3600
F2B_MAX_FAILS=3
F2B_WINDOW=600
F2B_BAN_SECONDS=86400
HONEYPOT_PORTS="23 2222 3389 8080"
RATELIMIT_ENABLED=true
RATELIMIT_PORTS="22"
RATELIMIT_RATE="10/min"
RATELIMIT_BURST=15
BLOCKLIST_URL="https://gist.githubusercontent.com/sngvy/07cee7ac810c9d222fbebddff8c1d1b8/raw/blacklist.txt"
TG_API_IPV4="149.154.167.220"
NOTIFY_ALERTS=true
NOTIFY_REPORT=true
NOTIFY_HONEYPOT=false
NOTIFY_FAIL2BAN=false
HONEYPOT_COOLDOWN=25

# Глобальные счётчики
IPV4=0
IPV6=0

# Авто-инициализация CONF_DIR
if [ "$EUID" -eq 0 ]; then
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    chmod 755 "$CONF_DIR" 2>/dev/null || true
    for f in whitelist.txt whitelist_ports.txt current.list previous.list watch.state alerts.seen \
             fail2ban.state fail2ban.bans geoip.cache protected.list last.diff; do
        [ ! -e "$CONF_DIR/$f" ] && touch "$CONF_DIR/$f" 2>/dev/null || true
    done
fi

[ -f "$CONFIG" ] && { set +u; source "$CONFIG"; set -u; }

need_root() { [ "$EUID" -ne 0 ] && { echo -e "${B_RED}Нужны root${NC}"; exit 1; }; }
log_ts() { date '+%Y-%m-%d %H:%M:%S'; }
log_info()  { echo -e "$(log_ts) [${B_GREEN}INFO${NC}] $*"; }
log_warn()  { echo -e "$(log_ts) [${B_YELLOW}WARN${NC}] $*"; }
log_error() { echo -e "$(log_ts) [${B_RED}ERR ${NC}] $*" >&2; }

# =============== Утилиты для безопасной работы с числами ===============
sanitize_num() {
    local v="${1:-0}"
    v="${v//[^0-9]/}"
    echo "${v:-0}"
}

ipset_count() {
    local set_name="$1"
    local cnt=0
    if ipset list "$set_name" &>/dev/null; then
        cnt=$(ipset list "$set_name" 2>/dev/null | grep -cE '^[0-9]' 2>/dev/null || true)
        cnt=$(sanitize_num "$cnt")
    fi
    echo "$cnt"
}

count_rules() {
    local m=$1
    if [ "$m" = "ufw" ]; then
        local s
        s=$(ufw status numbered 2>/dev/null || true)
        IPV4=$(echo "$s" | grep 'AntiScanner-Block' | grep -vc '(v6)' 2>/dev/null || true)
        IPV6=$(echo "$s" | grep 'AntiScanner-Block' | grep -c '(v6)' 2>/dev/null || true)
    else
        IPV4=$(iptables -S "$IPT_CHAIN" 2>/dev/null | grep -c '^-A .* -j DROP' 2>/dev/null || true)
        IPV6=$(ip6tables -S "$IPT_CHAIN" 2>/dev/null | grep -c '^-A .* -j DROP' 2>/dev/null || true)
    fi
    IPV4=$(sanitize_num "$IPV4")
    IPV6=$(sanitize_num "$IPV6")
}

color_n() {
    local n; n=$(sanitize_num "${1:-0}")
    if [ "$n" -eq 0 ]; then
        echo -e "${B_RED}${n}${NC}"
    elif [ "$n" -lt 50 ]; then
        echo -e "${B_YELLOW}${n}${NC}"
    else
        echo -e "${B_GREEN}${n}${NC}"
    fi
}

pad_v() {
    local raw="$1" width="$2"
    local stripped
    stripped=$(echo -e "$raw" | sed -E 's/\x1B$$[0-9;]*[mK]//g')
    local len
    len=$(python3 -c 'import sys; print(len(sys.argv[1]))' "$stripped" 2>/dev/null || echo "${#stripped}")
    local pad=$((width - len))
    (( pad < 0 )) && pad=0
    printf "%b%*s" "$raw" "$pad" ""
}

detect_nc_bin() {
    if [ -x /bin/nc.traditional ]; then
        echo "/bin/nc.traditional"
    elif [ -x /usr/bin/nc.traditional ]; then
        echo "/usr/bin/nc.traditional"
    elif command -v nc >/dev/null 2>&1 && ! nc -h 2>&1 | grep -qi 'OpenBSD'; then
        command -v nc
    else
        echo ""
    fi
}

detect_mode() {
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qiE '^\s*Status:\s*active'; then
        echo "ufw"
    else
        echo "iptables"
    fi
}

# =============== Telegram & Notify ===============
send_telegram() {
    local msg="$1"
    [ ! -f "$TG_CONF" ] && return 1
    set +u; source "$TG_CONF"; set -u
    [ -z "${TG_BOT_TOKEN:-}" ] || [ -z "${TG_CHAT_ID:-}" ] && return 1
    [ ${#msg} -gt 4000 ] && msg="${msg:0:3900}

<i>...обрезано</i>"

    local resp attempt
    for attempt in 1 2 3 4 5; do
        resp=$(curl -sS -4 \
            --resolve "api.telegram.org:443:${TG_API_IPV4}" \
            --max-time 30 --connect-timeout 10 \
            -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
            -d "chat_id=${TG_CHAT_ID}" -d "parse_mode=HTML" \
            -d "disable_web_page_preview=true" \
            --data-urlencode "text=${msg}" 2>&1)
        if echo "$resp" | grep -q '"ok":true'; then
            return 0
        fi
        if echo "$resp" | grep -q "can't parse entities"; then
            local plain
            plain=$(echo "$msg" | sed -E 's|</?[a-z][^>]*>||g')
            resp=$(curl -sS -4 \
                --resolve "api.telegram.org:443:${TG_API_IPV4}" \
                --max-time 30 -X POST \
                "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
                -d "chat_id=${TG_CHAT_ID}" \
                --data-urlencode "text=${plain}" 2>&1)
            if echo "$resp" | grep -q '"ok":true'; then
                return 0
            fi
        fi
        if echo "$resp" | grep -q '"ok":false'; then
            return 1
        fi
        sleep 3
    done
    return 1
}

notify() {
    local module="$1"; shift
    local msg="$*"
    local var="NOTIFY_${module^^}"
    local enabled="${!var:-true}"
    [ "$enabled" != "true" ] && return 0
    send_telegram "$msg"
}

cmd_telegram() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root
            echo -e "${B_CYAN}═══ Настройка Telegram ═══${NC}"
            read -rp "TG_BOT_TOKEN: " tok
            read -rp "TG_CHAT_ID: " cid
            { echo "TG_BOT_TOKEN=\"$tok\""; echo "TG_CHAT_ID=\"$cid\""; } > "$TG_CONF"
            chmod 600 "$TG_CONF"
            echo -e "${B_GREEN}✓ Сохранено${NC}"
            read -rp "Тест? [Y/n]: " a
            [[ ! "$a" =~ ^[Nn]$ ]] && cmd_telegram test
            ;;
        test)
            if send_telegram "🛡 <b>AntiScanner</b> тест с <code>$(hostname -s)</code>"; then
                echo -e "${B_GREEN}✓ Отправлено${NC}"
            else
                echo -e "${B_RED}✗ Ошибка${NC}"
            fi
            ;;
        *)
            if [ -f "$TG_CONF" ]; then
                echo -e "${B_GREEN}✓ Telegram настроен${NC}"
            else
                echo -e "${B_YELLOW}Не настроен${NC}"
            fi
            ;;
    esac
}

# =============== GeoIP ===============
geoip_lookup() {
    local ip="$1"
    [ -z "$ip" ] && { echo "XX"; return; }
    touch "$GEOIP_CACHE" 2>/dev/null || true
    local cached
    cached=$(grep "^${ip} " "$GEOIP_CACHE" 2>/dev/null | awk '{print $2}' | head -1)
    if [ -n "$cached" ]; then echo "$cached"; return; fi
    local cc
    cc=$(curl -s --max-time 5 "https://ipinfo.io/${ip}/country" 2>/dev/null | head -c 5 | tr -d '\r\n ')
    if [[ ! "$cc" =~ ^[A-Z]{2}$ ]]; then
        cc=$(curl -s --max-time 5 "http://ip-api.com/line/${ip}?fields=countryCode" 2>/dev/null | head -c 5 | tr -d '\r\n ')
    fi
    [[ ! "$cc" =~ ^[A-Z]{2}$ ]] && cc="XX"
    echo "${ip} ${cc}" >> "$GEOIP_CACHE" 2>/dev/null || true
    echo "$cc"
    sleep 0.15
}

flag_emoji() {
    local cc="${1:-XX}"
    [[ ! "$cc" =~ ^[A-Z]{2}$ ]] && { echo "🏳"; return; }
    python3 -c 'import sys; c=sys.argv[1]; print(chr(127397+ord(c[0]))+chr(127397+ord(c[1])))' "$cc" 2>/dev/null || echo "🏳"
}

cmd_geoip() {
    case "${1:-cache}" in
        lookup)
            [ -z "${2:-}" ] && { echo "antiscanner geoip lookup <ip>"; return 1; }
            local cc fl; cc=$(geoip_lookup "$2"); fl=$(flag_emoji "$cc")
            echo -e "${2}: ${fl} ${cc}"
            ;;
        cache)
            if [ -s "$GEOIP_CACHE" ]; then
                echo -e "${B_CYAN}═══ GeoIP кеш ($(wc -l <"$GEOIP_CACHE") записей) ═══${NC}"
                head -30 "$GEOIP_CACHE" | while read -r ip cc; do
                    local fl; fl=$(flag_emoji "$cc")
                    printf "  %s  ${B_YELLOW}%-2s${NC}  %s\n" "$fl" "$cc" "$ip"
                done
            else
                echo "(пусто)"
            fi
            ;;
        clear)
            need_root; > "$GEOIP_CACHE"
            echo -e "${B_GREEN}✓ Кеш очищен${NC}"
            ;;
        *) echo "antiscanner geoip {lookup <ip>|cache|clear}";;
    esac
}

# =============== Защита от самоблокировки ===============
collect_protected_ips() {
    {
        [ -n "${SSH_CLIENT:-}" ] && awk '{print $1}' <<< "$SSH_CLIENT"
        ss -tnH state established 2>/dev/null | awk '$4 ~ /:22$|:22[0-9]+$/ {print $5}' \
            | sed 's/\[//; s/$$.*//; s/:[0-9]*$//' | grep -v '^$' || true
        ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
        ip -6 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
        [ -f "$WHITELIST" ] && grep -vE '^\s*(#|$)' "$WHITELIST" | awk '{print $1}'
    } | sort -u | grep -v '^$'
}

ip_in_cidr() {
    python3 - "$1" "$2" 2>/dev/null <<'PY'
import sys, ipaddress
try:
    sys.exit(0 if ipaddress.ip_address(sys.argv[1]) in ipaddress.ip_network(sys.argv[2], strict=False) else 1)
except: sys.exit(2)
PY
}

is_whitelisted() {
    local ip="$1" cidr
    [ -f "$WHITELIST" ] && while IFS= read -r wl; do
        wl=$(echo "$wl" | xargs)
        [[ -z "$wl" || "$wl" == "#"* ]] && continue
        cidr="$wl"
        if [[ ! "$wl" =~ / ]]; then
            [[ "$wl" =~ : ]] && cidr="${wl}/128" || cidr="${wl}/32"
        fi
        ip_in_cidr "$ip" "$cidr" && return 0
    done < "$WHITELIST"
    while IFS= read -r own; do
        [ "$ip" = "$own" ] && return 0
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    return 1
}

is_valid_port() {
    local raw="$1"
    local proto="" p="$raw"
    if [[ "$raw" =~ / ]]; then
        p="${raw%%/*}"
        proto="${raw##*/}"
        if [[ "$proto" != "tcp" && "$proto" != "udp" && "$proto" != "all" && "$proto" != "both" ]]; then
            return 1
        fi
    fi
    # Одиночный порт 1-65535
    if [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ]; then
        return 0
    fi
    # Диапазон портов e.g. 8000:8080 или 8000-8080
    if [[ "$p" =~ ^([0-9]+)[:\-]([0-9]+)$ ]]; then
        local p1="${BASH_REMATCH[1]}"
        local p2="${BASH_REMATCH[2]}"
        if [ "$p1" -ge 1 ] && [ "$p1" -le 65535 ] && [ "$p2" -ge 1 ] && [ "$p2" -le 65535 ] && [ "$p1" -le "$p2" ]; then
            return 0
        fi
    fi
    return 1
}

is_port_whitelisted() {
    local check_port="$1" check_proto="${2:-tcp}"
    [ ! -f "$WHITELIST_PORTS" ] && return 1
    check_port=$(sanitize_num "$check_port")
    [ "$check_port" -eq 0 ] && return 1
    while IFS= read -r wp || [[ -n "$wp" ]]; do
        wp=$(echo "$wp" | xargs)
        [[ -z "$wp" || "$wp" == "#"* ]] && continue
        local p_proto="all"
        local p_num="$wp"
        if [[ "$wp" =~ / ]]; then
            p_num="${wp%%/*}"
            p_proto="${wp##*/}"
        fi
        if [ "$p_proto" != "all" ] && [ "$p_proto" != "both" ] && [ -n "$check_proto" ] && [ "$p_proto" != "$check_proto" ]; then
            continue
        fi
        # Проверка одиночного порта
        if [[ "$p_num" =~ ^[0-9]+$ ]] && [ "$p_num" -eq "$check_port" ]; then
            return 0
        fi
        # Проверка диапазона портов
        if [[ "$p_num" =~ ^([0-9]+)[:\-]([0-9]+)$ ]]; then
            local p_start="${BASH_REMATCH[1]}"
            local p_end="${BASH_REMATCH[2]}"
            if [ "$check_port" -ge "$p_start" ] && [ "$check_port" -le "$p_end" ]; then
                return 0
            fi
        fi
    done < "$WHITELIST_PORTS"
    return 1
}

apply_current_rules() {
    local mode; mode=$(detect_mode)
    if [ -f "$CURRENT" ] && [ -s "$CURRENT" ]; then
        [ "$mode" = "ufw" ] && apply_ufw "$CURRENT" || apply_ipt "$CURRENT"
    else
        local empty_tmp; empty_tmp=$(mktemp)
        [ "$mode" = "ufw" ] && apply_ufw "$empty_tmp" || apply_ipt "$empty_tmp"
        rm -f "$empty_tmp"
    fi
}

# =============== UPDATE ===============
cmd_update() {
    need_root
    local tmp filtered
    tmp=$(mktemp); filtered=$(mktemp)
    trap "rm -f '$tmp' '$filtered'" RETURN
    log_info "Скачивание..."
    curl -sSL --fail --max-time 60 --retry 5 --retry-delay 3 \
         "$BLOCKLIST_URL" -o "$tmp" || { log_error "Не скачалось"; return 1; }
    [ ! -s "$tmp" ] && { log_error "Пустой"; return 1; }
    sed -i 's/\r$//' "$tmp"
    collect_protected_ips > "$PROTECTED_FILE"
    local excluded=0
    while IFS= read -r line; do
        line=$(echo "$line" | xargs)
        [[ -z "$line" || "$line" == "#"* ]] && continue
        local cidr="$line"
        [[ ! "$line" =~ / ]] && { [[ "$line" =~ : ]] && cidr="${line}/128" || cidr="${line}/32"; }
        local skip=0
        while IFS= read -r pip; do
            [ -z "$pip" ] && continue
            if ip_in_cidr "$pip" "$cidr"; then
                skip=1; excluded=$((excluded+1)); break
            fi
        done < "$PROTECTED_FILE"
        [ $skip -eq 0 ] && echo "$line" >> "$filtered"
    done < "$tmp"
    [ -f "$CURRENT" ] && cp "$CURRENT" "$PREVIOUS"
    cp "$filtered" "$CURRENT"
    local mode; mode=$(detect_mode)
    log_info "Применение через $mode..."
    [ "$mode" = "ufw" ] && apply_ufw "$filtered" || apply_ipt "$filtered"
    log_info "Готово, исключено: $excluded"
}

apply_ufw() {
    local ok=0 num
    while IFS= read -r line; do
        num=$(echo "$line" | grep -oE '^$$\s*[0-9]+$$' | tr -d '[] ')
        [ -n "$num" ] && ufw --force delete "$num" >/dev/null 2>&1
    done < <(ufw status numbered 2>/dev/null | grep -E 'AntiScanner-Block|AntiScanner-WL-Port' | tac || true)
    while IFS= read -r s || [[ -n "$s" ]]; do
        s=$(echo "$s" | xargs)
        [[ -z "$s" || "$s" == "#"* ]] && continue
        if [[ "$s" =~ \. || "$s" =~ : ]]; then
            ufw insert 1 deny log from "$s" comment 'AntiScanner-Block' >/dev/null 2>&1 && ok=$((ok+1)) || true
        fi
    done < "$1"
    if [ -f "$WHITELIST_PORTS" ]; then
        local p_ok=0
        while IFS= read -r wp || [[ -n "$wp" ]]; do
            wp=$(echo "$wp" | xargs)
            [[ -z "$wp" || "$wp" == "#"* ]] && continue
            local proto="" p_num="$wp"
            if [[ "$wp" =~ / ]]; then
                p_num="${wp%%/*}"
                proto="/${wp##*/}"
            fi
            p_num="${p_num//:/-}"
            ufw insert 1 allow "${p_num}${proto}" comment 'AntiScanner-WL-Port' >/dev/null 2>&1 && p_ok=$((p_ok+1)) || true
        done < "$WHITELIST_PORTS"
        [ "$p_ok" -gt 0 ] && log_info "UFW: $p_ok правил белого списка портов"
    fi
    log_info "UFW: $ok правил блоклиста"
    ufw reload >/dev/null 2>&1 || true
}

apply_ipt() {
    for c in iptables ip6tables; do
        $c -L "$IPT_CHAIN" -n &>/dev/null || $c -N "$IPT_CHAIN"
        $c -F "$IPT_CHAIN"
        $c -C INPUT -j "$IPT_CHAIN" &>/dev/null || $c -I INPUT 1 -j "$IPT_CHAIN"
    done
    if [ -f "$WHITELIST_PORTS" ]; then
        while IFS= read -r wp || [[ -n "$wp" ]]; do
            wp=$(echo "$wp" | xargs)
            [[ -z "$wp" || "$wp" == "#"* ]] && continue
            local proto="all"
            local p_num="$wp"
            if [[ "$wp" =~ / ]]; then
                p_num="${wp%%/*}"
                proto="${wp##*/}"
            fi
            p_num="${p_num//-/:}"
            for c in iptables ip6tables; do
                if [ "$proto" = "all" ] || [ "$proto" = "both" ]; then
                    $c -A "$IPT_CHAIN" -p tcp --dport "$p_num" -m comment --comment "AntiScanner-WL-Port" -j RETURN 2>/dev/null || true
                    $c -A "$IPT_CHAIN" -p udp --dport "$p_num" -m comment --comment "AntiScanner-WL-Port" -j RETURN 2>/dev/null || true
                else
                    $c -A "$IPT_CHAIN" -p "$proto" --dport "$p_num" -m comment --comment "AntiScanner-WL-Port" -j RETURN 2>/dev/null || true
                fi
            done
        done < "$WHITELIST_PORTS"
    fi
    local c
    while IFS= read -r s || [[ -n "$s" ]]; do
        s=$(echo "$s" | xargs)
        [[ -z "$s" || "$s" == "#"* ]] && continue
        c=iptables
        [[ "$s" =~ : ]] && c=ip6tables
        [[ ! "$s" =~ \. && ! "$s" =~ : ]] && continue
        $c -A "$IPT_CHAIN" -s "$s" -m limit --limit 5/min -j LOG --log-prefix "ANTISCANNER-BLOCK: " 2>/dev/null
        $c -A "$IPT_CHAIN" -s "$s" -j DROP 2>/dev/null
    done < "$1"
    mkdir -p /etc/iptables
    iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    ip6tables-save > /etc/iptables/rules.v6 2>/dev/null || true
}

# =============== WATCH (исправлено: безопасные числа) ===============
cmd_watch() {
    [ ! -f "$LOG_BLOCKED" ] && exit 0

    # Безопасное чтение last_pos (защита от пустого/битого WATCH_STATE)
    local last_pos=0
    if [ -f "$WATCH_STATE" ]; then
        local tmp_pos
        tmp_pos=$(cat "$WATCH_STATE" 2>/dev/null || true)
        tmp_pos=$(sanitize_num "$tmp_pos")
        last_pos="$tmp_pos"
    fi

    # Безопасное чтение cur_size
    local cur_size
    cur_size=$(stat -c %s "$LOG_BLOCKED" 2>/dev/null || echo 0)
    cur_size=$(sanitize_num "$cur_size")

    [ "$cur_size" -lt "$last_pos" ] && last_pos=0

    local now; now=$(date +%s)
    local window_start=$((now - ALERT_WINDOW))
    local new_data; new_data=$(tail -c +$((last_pos+1)) "$LOG_BLOCKED" 2>/dev/null || true)
    echo "$cur_size" > "$WATCH_STATE"
    [ -z "$new_data" ] && exit 0

    local tmp; tmp=$(mktemp); trap "rm -f '$tmp'" EXIT
    echo "$new_data" | while IFS= read -r line; do
        local ts_str ts src dpt
        ts_str=$(echo "$line" | awk '{print $1,$2,$3}')
        ts=$(date -d "$ts_str" +%s 2>/dev/null || echo 0)
        ts=$(sanitize_num "$ts")
        [ "$ts" -lt "$window_start" ] && continue
        src=$(echo "$line" | grep -oE 'SRC=[^ ]+' | cut -d= -f2)
        dpt=$(echo "$line" | grep -oE 'DPT=[0-9]+' | cut -d= -f2)
        [ -n "$dpt" ] && is_port_whitelisted "$dpt" && continue
        [ -n "$src" ] && echo "$src $dpt" >> "$tmp"
    done
    [ ! -s "$tmp" ] && exit 0

    local alerts=""
    touch "$ALERTS_SEEN"
    while read -r cnt ip; do
        cnt=$(sanitize_num "$cnt")
        [ "$cnt" -lt "$ALERT_THRESHOLD" ] && continue
        local seen_ts
        seen_ts=$(grep "^$ip " "$ALERTS_SEEN" 2>/dev/null | awk '{print $2}' | head -1 || echo 0)
        seen_ts=$(sanitize_num "$seen_ts")
        [ $((now - seen_ts)) -lt "$ALERT_COOLDOWN" ] && continue
        local cc fl
        cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
        alerts="${alerts}⚠️ ${fl} <code>${ip}</code> (${cc}) — <b>${cnt}</b> попыток"$'\n'
        grep -v "^$ip " "$ALERTS_SEEN" 2>/dev/null > "$ALERTS_SEEN.tmp" || true
        echo "$ip $now" >> "$ALERTS_SEEN.tmp"
        mv "$ALERTS_SEEN.tmp" "$ALERTS_SEEN"
    done < <(awk '{print $1}' "$tmp" | sort | uniq -c | sort -rn)

    if [ -n "$alerts" ]; then
        local msg="🚨 <b>AntiScanner Alert</b>
🖥 <code>$(hostname -s)</code>

${alerts}"
        notify "alerts" "$msg" || true
    fi
}

# =============== FAIL2BAN ===============
ensure_f2b_infra() {
    ipset list "$IPSET_F2B" &>/dev/null || ipset create "$IPSET_F2B" hash:ip timeout "$F2B_BAN_SECONDS" maxelem 65536
    iptables -C INPUT -m set --match-set "$IPSET_F2B" src -j DROP 2>/dev/null || \
        iptables -I INPUT 1 -m set --match-set "$IPSET_F2B" src -j DROP
}

f2b_ban() {
    local ip="$1" reason="${2:-fail2ban}"
    is_whitelisted "$ip" && return
    ensure_f2b_infra
    ipset add "$IPSET_F2B" "$ip" timeout "$F2B_BAN_SECONDS" -exist 2>/dev/null || true
    echo "$ip $(date +%s) $F2B_BAN_SECONDS $reason" >> "$F2B_BANS"
    local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
    log_info "🔒 BAN: $ip ($reason)"
    notify "fail2ban" "🔒 <b>Fail2ban</b>
${fl} <code>${ip}</code> (${cc})
Причина: ${reason}
🖥 $(hostname -s)" || true
}

cmd_fail2ban() {
    local action="${1:-status}"
    case "$action" in
        run)
            need_root
            ensure_f2b_infra
            log_info "F2B watcher started"
            declare -A FAIL_COUNT FAIL_FIRST
            journalctl -u ssh -u sshd -f -n 0 --output=short-iso 2>/dev/null | \
            while IFS= read -r line; do
                local ip; ip=$(echo "$line" | grep -oE '(Failed password|Invalid user).*from [0-9a-fA-F:.]+' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[0-9a-fA-F:]+' | tail -1)
                [ -z "$ip" ] && continue
                is_whitelisted "$ip" && continue
                local now; now=$(date +%s)
                local first="${FAIL_FIRST[$ip]:-0}"
                if [ $((now - first)) -gt "$F2B_WINDOW" ]; then
                    FAIL_COUNT[$ip]=1; FAIL_FIRST[$ip]=$now
                else
                    FAIL_COUNT[$ip]=$((${FAIL_COUNT[$ip]:-0} + 1))
                fi
                if [ "${FAIL_COUNT[$ip]}" -ge "$F2B_MAX_FAILS" ]; then
                    f2b_ban "$ip" "SSH brute-force"
                    unset FAIL_COUNT[$ip]; unset FAIL_FIRST[$ip]
                fi
            done
            ;;
        unban-expired)
            need_root
            [ ! -f "$F2B_BANS" ] && return
            local now; now=$(date +%s)
            local new; new=$(mktemp)
            while IFS=' ' read -r ip ts secs reason; do
                [ -z "$ip" ] && continue
                ts=$(sanitize_num "$ts")
                secs=$(sanitize_num "$secs")
                if [ $((ts + secs)) -gt "$now" ]; then
                    echo "$ip $ts $secs $reason" >> "$new"
                else
                    ipset del "$IPSET_F2B" "$ip" 2>/dev/null || true
                fi
            done < "$F2B_BANS"
            mv "$new" "$F2B_BANS"
            ;;
        list)
            echo -e "${B_CYAN}═══ Fail2ban активные ═══${NC}"
            ipset list "$IPSET_F2B" 2>/dev/null | grep -E '^[0-9]' | head -50
            ;;
        unban)
            need_root
            local ip="${2:-}"
            [ -z "$ip" ] && { echo "fail2ban unban <ip>"; return 1; }
            ipset del "$IPSET_F2B" "$ip" 2>/dev/null && echo -e "${B_GREEN}✓ Unban: $ip${NC}" || echo "Не найден"
            ;;
        silent|quiet)
            need_root
            grep -q '^NOTIFY_FAIL2BAN=' "$CONFIG" && sed -i 's/^NOTIFY_FAIL2BAN=.*/NOTIFY_FAIL2BAN=false/' "$CONFIG" || echo 'NOTIFY_FAIL2BAN=false' >> "$CONFIG"
            echo -e "${B_GREEN}✓ Без уведомлений${NC}"
            ;;
        verbose|notify)
            need_root
            grep -q '^NOTIFY_FAIL2BAN=' "$CONFIG" && sed -i 's/^NOTIFY_FAIL2BAN=.*/NOTIFY_FAIL2BAN=true/' "$CONFIG" || echo 'NOTIFY_FAIL2BAN=true' >> "$CONFIG"
            echo -e "${B_GREEN}✓ Уведомления включены${NC}"
            ;;
        disable|off|stop)
            need_root
            systemctl disable --now antiscanner-fail2ban 2>/dev/null || true
            echo -e "${B_GREEN}✓ Отключён${NC}"
            ;;
        enable|on|start)
            need_root; ensure_f2b_infra
            systemctl enable --now antiscanner-fail2ban.service
            echo -e "${B_GREEN}✓ Включён${NC}"
            ;;
        status|*)
            systemctl is-active --quiet antiscanner-fail2ban && echo -e "${B_GREEN}✓ Работает${NC}" || echo -e "${B_RED}✗ Остановлен${NC}"
            local cnt; cnt=$(ipset_count "$IPSET_F2B")
            echo -e "Забанено: ${B_YELLOW}${cnt}${NC}"
            echo -e "Уведомления: $([ "${NOTIFY_FAIL2BAN:-false}" = "true" ] && echo "${B_GREEN}вкл${NC}" || echo "${DIM}выкл${NC}")"
            ;;
    esac
}

# =============== HONEYPOT ===============
declare -A HONEYPOT_LAST_SEEN

honeypot_should_notify() {
    local ip="$1"
    local now; now=$(date +%s)
    local last=${HONEYPOT_LAST_SEEN[$ip]:-0}
    if [ $((now - last)) -lt "$HONEYPOT_COOLDOWN" ]; then
        return 1
    fi
    HONEYPOT_LAST_SEEN[$ip]=$now
    return 0
}

ensure_hp_infra() {
    ipset list "$IPSET_HP" &>/dev/null || ipset create "$IPSET_HP" hash:ip timeout 86400 maxelem 65536
    iptables -C INPUT -m set --match-set "$IPSET_HP" src -j DROP 2>/dev/null || \
        iptables -I INPUT 1 -m set --match-set "$IPSET_HP" src -j DROP
}

hp_listener() {
    local port="$1"
    local NC_BIN; NC_BIN=$(detect_nc_bin)
    [ -z "$NC_BIN" ] && { log_error "nc.traditional не найден"; return 1; }
    touch "$LOG_HP" 2>/dev/null
    chmod 644 "$LOG_HP" 2>/dev/null

    while true; do
        "$NC_BIN" -l -n -p "$port" -w 1 </dev/null >/dev/null 2>&1 || true
        local ip
        ip=$(ss -tn state close-wait "dport = :$port" 2>/dev/null | awk 'NR>1{print $5}' | cut -d: -f1 | head -1)
        [ -z "$ip" ] && ip=$(ss -tn "sport = :$port" 2>/dev/null | awk 'NR>1 && $5 ~ /^[0-9]+\./ {print $5}' | cut -d: -f1 | head -1)

        if [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
            if is_whitelisted "$ip" || is_port_whitelisted "$port"; then
                :
            elif honeypot_should_notify "$ip"; then
                echo "$(date '+%b %e %H:%M:%S') $(hostname -s) antiscanner: HONEYPOT-HIT: SRC=$ip DPT=$port PROTO=TCP" >> "$LOG_HP"
                logger -t antiscanner "HONEYPOT-HIT: SRC=$ip DPT=$port" 2>/dev/null || true
                ipset add "$IPSET_HP" "$ip" timeout 86400 -exist 2>/dev/null || true
                local cc fl; cc=$(geoip_lookup "$ip"); fl=$(flag_emoji "$cc")
                log_info "🕷 HONEYPOT: $ip → port $port → BANNED"
                notify "honeypot" "🕷 <b>Honeypot Hit!</b>
${fl} <code>${ip}</code> (${cc}) → port <b>${port}</b>
🖥 $(hostname -s)" || true
            fi
        fi
        sleep 0.8
    done
}

cmd_honeypot() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root; ensure_hp_infra
            echo "$HONEYPOT_PORTS" > "$CONF_DIR/honeypot.ports"
            log_info "Настроен на порты: $HONEYPOT_PORTS"
            ;;
        run)
            need_root
            [ -f "$CONF_DIR/honeypot.ports" ] && HONEYPOT_PORTS=$(cat "$CONF_DIR/honeypot.ports")
            ensure_hp_infra
            local NC_BIN; NC_BIN=$(detect_nc_bin)
            [ -z "$NC_BIN" ] && { log_error "nc.traditional не найден"; exit 1; }
            log_info "Honeypot listener: $HONEYPOT_PORTS"
            local pids=""
            for port in $HONEYPOT_PORTS; do
                if is_port_whitelisted "$port"; then
                    log_warn "Порт $port в белом списке — Honeypot пропущен"
                    continue
                fi
                hp_listener "$port" &
                pids="$pids $!"
            done
            trap "kill $pids 2>/dev/null" EXIT TERM INT
            wait
            ;;
        remove)
            need_root
            iptables -D INPUT -m set --match-set "$IPSET_HP" src -j DROP 2>/dev/null || true
            ipset destroy "$IPSET_HP" 2>/dev/null || true
            systemctl disable --now antiscanner-honeypot 2>/dev/null || true
            echo -e "${B_GREEN}✓ Удалён${NC}"
            ;;
        disable|off|stop)
            need_root
            systemctl disable --now antiscanner-honeypot 2>/dev/null || true
            echo -e "${B_GREEN}✓ Отключён${NC}"
            ;;
        enable|on|start)
            need_root; ensure_hp_infra
            systemctl enable --now antiscanner-honeypot.service
            echo -e "${B_GREEN}✓ Включён${NC}"
            ;;
        silent|quiet)
            need_root
            grep -q '^NOTIFY_HONEYPOT=' "$CONFIG" && sed -i 's/^NOTIFY_HONEYPOT=.*/NOTIFY_HONEYPOT=false/' "$CONFIG" || echo 'NOTIFY_HONEYPOT=false' >> "$CONFIG"
            echo -e "${B_GREEN}✓ Без уведомлений${NC}"
            ;;
        verbose|notify)
            need_root
            grep -q '^NOTIFY_HONEYPOT=' "$CONFIG" && sed -i 's/^NOTIFY_HONEYPOT=.*/NOTIFY_HONEYPOT=true/' "$CONFIG" || echo 'NOTIFY_HONEYPOT=true' >> "$CONFIG"
            echo -e "${B_GREEN}✓ Уведомления включены${NC}"
            ;;
        list|bans)
            echo -e "${B_CYAN}═══ Honeypot bans ═══${NC}"
            ipset list "$IPSET_HP" 2>/dev/null | grep -E '^[0-9]' | head -50
            ;;
        status|*)
            systemctl is-active --quiet antiscanner-honeypot && echo -e "${B_GREEN}✓ Работает${NC}" || echo -e "${B_RED}✗ Остановлен${NC}"
            echo -e "Порты: ${B_MAGENTA}${HONEYPOT_PORTS}${NC}"
            local NC_BIN; NC_BIN=$(detect_nc_bin)
            echo -e "nc: ${B_GREEN}${NC_BIN:-НЕ НАЙДЕН}${NC}"
            local cnt; cnt=$(ipset_count "$IPSET_HP")
            echo -e "Забанено: ${B_YELLOW}${cnt}${NC}"
            echo -e "Уведомления: $([ "${NOTIFY_HONEYPOT:-false}" = "true" ] && echo "${B_GREEN}вкл${NC}" || echo "${DIM}выкл${NC}")"
            echo -e "Cooldown: ${B_CYAN}${HONEYPOT_COOLDOWN}${NC} сек"
            ;;
    esac
}

# =============== RATELIMIT ===============
cmd_ratelimit() {
    local action="${1:-status}"
    case "$action" in
        setup)
            need_root
            [ "$RATELIMIT_ENABLED" != "true" ] && { echo -e "${B_YELLOW}Выключен${NC}"; return; }
            for port in $RATELIMIT_PORTS; do
                while iptables -D INPUT -p tcp --dport "$port" -m conntrack --ctstate NEW -m hashlimit \
                    --hashlimit-above "$RATELIMIT_RATE" --hashlimit-burst "$RATELIMIT_BURST" \
                    --hashlimit-mode srcip --hashlimit-name "rl-$port" -j DROP 2>/dev/null; do :; done
                iptables -I INPUT -p tcp --dport "$port" -m conntrack --ctstate NEW \
                    -m hashlimit --hashlimit-above "$RATELIMIT_RATE" \
                    --hashlimit-burst "$RATELIMIT_BURST" \
                    --hashlimit-mode srcip --hashlimit-name "rl-$port" \
                    -m comment --comment "AntiScanner-RateLimit" -j DROP
            done
            mkdir -p /etc/iptables && iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
            echo -e "${B_GREEN}✓ Настроен${NC}"
            ;;
        remove)
            need_root
            local rl_rules
            rl_rules=$(iptables-save 2>/dev/null | grep 'AntiScanner-RateLimit' || true)
            if [ -n "$rl_rules" ]; then
                echo "$rl_rules" | sed 's/^-A /-D /' | while read -r rule; do
                    eval "iptables $rule" 2>/dev/null || true
                done
            fi
            echo -e "${B_GREEN}✓ Удалён${NC}"
            ;;
        status|*)
            local rules
            rules=$(iptables-save 2>/dev/null | grep -c 'AntiScanner-RateLimit' 2>/dev/null || true)
            rules=$(sanitize_num "$rules")
            if [ "$rules" -gt 0 ]; then
                echo -e "${B_GREEN}✓ Активен${NC} (правил: $rules)"
            else
                echo -e "${B_RED}✗ Не активен${NC}"
            fi
            ;;
    esac
}

# =============== STATUS ===============
cmd_status() {
    local mode; mode=$(detect_mode)
    count_rules "$mode"
    local total=$((IPV4 + IPV6))

    local wl_ips=0 wl_ports=0
    [ -f "$WHITELIST" ] && wl_ips=$(grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | wc -l || echo 0)
    [ -f "$WHITELIST_PORTS" ] && wl_ports=$(grep -vE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null | wc -l || echo 0)
    wl_ips=$(sanitize_num "$wl_ips")
    wl_ports=$(sanitize_num "$wl_ports")

    local f2b_cnt; f2b_cnt=$(ipset_count "$IPSET_F2B")
    local hp_cnt; hp_cnt=$(ipset_count "$IPSET_HP")

    local tg_st="${DIM}нет${NC}"; [ -f "$TG_CONF" ] && tg_st="${B_GREEN}OK${NC}"
    local f2b_st="${DIM}off${NC}"; systemctl is-active --quiet antiscanner-fail2ban 2>/dev/null && f2b_st="${B_GREEN}running${NC}"
    local hp_st="${DIM}off${NC}"; systemctl is-active --quiet antiscanner-honeypot 2>/dev/null && hp_st="${B_GREEN}running${NC}"
    local rl_st="${DIM}off${NC}"; iptables-save 2>/dev/null | grep -q 'AntiScanner-RateLimit' && rl_st="${B_GREEN}active${NC}"

    echo
    echo -e "${B_CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${B_CYAN}║${B_WHITE}       ANTISCANNER v3.3.7 — статус                        ${B_CYAN}║${NC}"
    echo -e "${B_CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo -e "  Режим: ${B_MAGENTA}${mode^^}${NC}"
    echo -e "  Блоклист: $(color_n "$total") (v4=$IPV4, v6=$IPV6)"
    echo -e "  Whitelist: IP=$(color_n "$wl_ips"), портов=$(color_n "$wl_ports")"
    echo -e "  Fail2ban: $f2b_st (забанено: $(color_n "$f2b_cnt"))"
    echo -e "  Honeypot: $hp_st (забанено: $(color_n "$hp_cnt"))"
    echo -e "  Rate-limit: $rl_st"
    echo -e "  Telegram: $tg_st"
    echo
}

# =============== DIFF ===============
cmd_diff() {
    [ ! -f "$LAST_DIFF" ] && { echo "Нет диффа"; return; }
    echo -e "${B_CYAN}═══ Последний дифф ═══${NC}"
    head -1 "$LAST_DIFF"
    awk '/^## ADDED/{f=1;next} /^## REMOVED/{f=0} f && NF' "$LAST_DIFF" | head -20 | while read -r l; do echo -e "  ${B_GREEN}+${NC} $l"; done
    awk '/^## REMOVED/{f=1;next} f && NF' "$LAST_DIFF" | head -20 | while read -r l; do echo -e "  ${B_RED}-${NC} $l"; done
}

# =============== REPORT ===============
cmd_report() {
    local since
    case "${1:-}" in
        --24h|-d) since=$(date -d '24 hours ago' +%s) ;;
        --7d|-w)  since=$(date -d '7 days ago' +%s) ;;
        --all|-a) since=0 ;;
        *) since=$(cat "$REPORT_STATE" 2>/dev/null || date -d '24 hours ago' +%s) ;;
    esac
    since=$(sanitize_num "$since")

    local mode; mode=$(detect_mode); count_rules "$mode"
    local total=$((IPV4+IPV6))

    local bl_count=0 hp_count=0
    [ -f "$LOG_BLOCKED" ] && bl_count=$(wc -l <"$LOG_BLOCKED" 2>/dev/null || echo 0)
    [ -f "$LOG_HP" ] && hp_count=$(wc -l <"$LOG_HP" 2>/dev/null || echo 0)
    bl_count=$(sanitize_num "$bl_count")
    hp_count=$(sanitize_num "$hp_count")

    local msg="🛡 <b>AntiScanner Report</b>
🖥 <code>$(hostname -s)</code>
📊 Блоклист: <b>${total}</b>
📊 Атаки: <b>$((bl_count + hp_count))</b>"

    echo "$msg" | sed -E 's|</?[a-z][^>]*>||g'
    notify "report" "$msg" && echo -e "${B_GREEN}✓ Отправлено${NC}" || echo -e "${B_YELLOW}TG не настроен${NC}"
    date +%s > "$REPORT_STATE"
}

# =============== LOGS, WHITELIST, NOTIFY, UNINSTALL ===============
cmd_logs() {
    case "${1:-update}" in
        update) tail -30 "$LOG_UPDATE" 2>/dev/null || echo "(пусто)" ;;
        blocked) tail -30 "$LOG_BLOCKED" 2>/dev/null || echo "(пусто)" ;;
        alerts) tail -30 "$LOG_ALERTS" 2>/dev/null || echo "(пусто)" ;;
        f2b|fail2ban) tail -30 "$LOG_F2B" 2>/dev/null || echo "(пусто)" ;;
        honeypot|hp) tail -30 "$LOG_HP" 2>/dev/null || echo "(пусто)" ;;
        clear)
            need_root
            for f in "$LOG_UPDATE" "$LOG_BLOCKED" "$LOG_ALERTS" "$LOG_F2B" "$LOG_HP"; do
                [ -f "$f" ] && truncate -s 0 "$f" && echo -e "${B_GREEN}✓${NC} очищен: $f"
            done
            ;;
        *) echo "logs {update|blocked|alerts|f2b|honeypot|clear}" ;;
    esac
}

cmd_whitelist() {
    local sub="${1:-list}"
    shift 2>/dev/null || true

    case "$sub" in
        list)
            local target="${1:-all}"
            if [ "$target" = "ip" ] || [ "$target" = "ips" ]; then
                echo -e "${B_CYAN}═══ Белый список IP ═══${NC}"
                grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | nl -ba || echo "(пусто)"
            elif [ "$target" = "port" ] || [ "$target" = "ports" ]; then
                echo -e "${B_CYAN}═══ Белый список портов ═══${NC}"
                grep -vE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null | nl -ba || echo "(пусто)"
            else
                echo -e "${B_CYAN}═══ Белый список IP ═══${NC}"
                if [ -s "$WHITELIST" ] && grep -qvE '^\s*(#|$)' "$WHITELIST" 2>/dev/null; then
                    grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | nl -ba
                else
                    echo "  (пусто)"
                fi
                echo
                echo -e "${B_CYAN}═══ Белый список портов ═══${NC}"
                if [ -s "$WHITELIST_PORTS" ] && grep -qvE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null; then
                    grep -vE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null | nl -ba
                else
                    echo "  (пусто)"
                fi
            fi
            ;;
        ip|ips)
            local action="${1:-list}"
            shift 2>/dev/null || true
            case "$action" in
                list)
                    echo -e "${B_CYAN}═══ Белый список IP ═══${NC}"
                    grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | nl -ba || echo "(пусто)"
                    ;;
                add)
                    need_root
                    local val="${1:-}"
                    [ -z "$val" ] && { echo "whitelist ip add <ip|cidr>"; return 1; }
                    grep -qxF "$val" "$WHITELIST" 2>/dev/null && { echo "уже есть в списке IP"; return 0; }
                    echo "$val" >> "$WHITELIST"
                    echo -e "${B_GREEN}✓ IP добавлен в белый список:${NC} $val"
                    ;;
                del|rm)
                    need_root
                    local val="${1:-}"
                    [ -z "$val" ] && { echo "whitelist ip del <ip|cidr>"; return 1; }
                    sed -i "\|^${val}\s*\$|d" "$WHITELIST"
                    echo -e "${B_GREEN}✓ IP удалён из белого списка:${NC} $val"
                    ;;
                *)
                    echo "antiscanner whitelist ip {list|add <ip>|del <ip>}"
                    ;;
            esac
            ;;
        port|ports)
            local action="${1:-list}"
            shift 2>/dev/null || true
            case "$action" in
                list)
                    echo -e "${B_CYAN}═══ Белый список портов ═══${NC}"
                    grep -vE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null | nl -ba || echo "(пусто)"
                    ;;
                add)
                    need_root
                    local val="${1:-}"
                    [ -z "$val" ] && { echo "whitelist port add <порт|диапазон> (например: 80, 443, 80/tcp, 8000:8080)"; return 1; }
                    if ! is_valid_port "$val"; then
                        echo -e "${B_RED}✗ Некорректный порт или диапазон:${NC} $val (примеры: 80, 443, 80/tcp, 53/udp, 8000:8080)"
                        return 1
                    fi
                    grep -qxF "$val" "$WHITELIST_PORTS" 2>/dev/null && { echo "уже есть в списке портов"; return 0; }
                    echo "$val" >> "$WHITELIST_PORTS"
                    echo -e "${B_GREEN}✓ Порт добавлен в белый список:${NC} $val"
                    apply_current_rules
                    ;;
                del|rm)
                    need_root
                    local val="${1:-}"
                    [ -z "$val" ] && { echo "whitelist port del <порт>"; return 1; }
                    sed -i "\|^${val}\s*\$|d" "$WHITELIST_PORTS"
                    echo -e "${B_GREEN}✓ Порт удалён из белого списка:${NC} $val"
                    apply_current_rules
                    ;;
                *)
                    echo "antiscanner whitelist port {list|add <port>|del <port>}"
                    ;;
            esac
            ;;
        add)
            need_root
            local arg1="${1:-}" arg2="${2:-}"
            if [ "$arg1" = "port" ] || [ "$arg1" = "ports" ] || [ "$arg1" = "-p" ]; then
                cmd_whitelist port add "$arg2"
            elif [ "$arg1" = "ip" ] || [ "$arg1" = "ips" ]; then
                cmd_whitelist ip add "$arg2"
            elif is_valid_port "$arg1" && [[ ! "$arg1" =~ \. && ! "$arg1" =~ :.*: ]]; then
                cmd_whitelist port add "$arg1"
            elif [ -n "$arg1" ]; then
                cmd_whitelist ip add "$arg1"
            else
                echo "antiscanner whitelist add [ip|port] <значение>"
                echo "  Примеры: antiscanner whitelist add 1.2.3.4"
                echo "           antiscanner whitelist add port 80"
                echo "           antiscanner whitelist add 8000:8080"
            fi
            ;;
        del|rm)
            need_root
            local arg1="${1:-}" arg2="${2:-}"
            if [ "$arg1" = "port" ] || [ "$arg1" = "ports" ] || [ "$arg1" = "-p" ]; then
                cmd_whitelist port del "$arg2"
            elif [ "$arg1" = "ip" ] || [ "$arg1" = "ips" ]; then
                cmd_whitelist ip del "$arg2"
            elif is_valid_port "$arg1" && grep -qxF "$arg1" "$WHITELIST_PORTS" 2>/dev/null; then
                cmd_whitelist port del "$arg1"
            elif [ -n "$arg1" ]; then
                cmd_whitelist ip del "$arg1"
            else
                echo "antiscanner whitelist del [ip|port] <значение>"
            fi
            ;;
        *)
            echo "antiscanner whitelist {list|add|del|ip|port}"
            ;;
    esac
}

test_result() {
    case "$1" in
        ok) echo -e "  ${B_GREEN}✓${NC} $2 ${DIM}${3:-}${NC}" ;;
        fail) echo -e "  ${B_RED}✗${NC} $2 ${B_YELLOW}${3:-}${NC}" ;;
        warn) echo -e "  ${B_YELLOW}⚠${NC} $2 ${DIM}${3:-}${NC}" ;;
        info) echo -e "  ${B_BLUE}ⓘ${NC} $2 ${DIM}${3:-}${NC}" ;;
    esac
}

cmd_test() {
    echo -e "${B_CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${B_CYAN}║${B_WHITE}         САМОДИАГНОСТИКА ANTISCANNER v3.3.7               ${B_CYAN}║${NC}"
    echo -e "${B_CYAN}╚══════════════════════════════════════════════════════════╝${NC}"

    echo -e "\n${B_WHITE}▶ Операционная система${NC}"
    if [ -f /etc/os-release ]; then
        local os_id os_ver os_pretty
        os_id=$(. /etc/os-release && echo "${ID:-}")
        os_ver=$(. /etc/os-release && echo "${VERSION_ID:-}")
        os_pretty=$(. /etc/os-release && echo "${PRETTY_NAME:-}")
        if [ "$os_id" = "ubuntu" ] && [[ "$os_ver" =~ ^24 ]]; then
            test_result ok "Ubuntu ${os_ver}" "$os_pretty"
        elif [ "$os_id" = "ubuntu" ] && [[ "$os_ver" =~ ^22 ]]; then
            test_result ok "Ubuntu ${os_ver}" "$os_pretty"
        else
            test_result warn "ОС" "$os_pretty"
        fi
    fi

    echo -e "\n${B_WHITE}▶ Система${NC}"
    [ "$EUID" -eq 0 ] && test_result ok "Запущено от root" || test_result warn "Не root"
    for c in curl python3 iptables ipset ss awk sed grep nc; do
        command -v "$c" >/dev/null 2>&1 && test_result ok "$c" "$(command -v $c)" || test_result fail "$c" "не найден"
    done

    echo -e "\n${B_WHITE}▶ Netcat (для honeypot)${NC}"
    local NC_BIN; NC_BIN=$(detect_nc_bin)
    [ -n "$NC_BIN" ] && test_result ok "nc.traditional" "$NC_BIN" || test_result fail "netcat-traditional" "не найден"

    echo -e "\n${B_WHITE}▶ Фаервол${NC}"
    local mode; mode=$(detect_mode); test_result info "Режим" "$mode"
    count_rules "$mode"
    if [ "$((IPV4+IPV6))" -gt 0 ]; then
        test_result ok "Блоклист" "IPv4=$IPV4 IPv6=$IPV6"
    else
        test_result warn "Блоклист" "0 правил"
    fi

    echo -e "\n${B_WHITE}▶ Белые списки (Whitelist)${NC}"
    local wl_ips=0 wl_ports=0
    [ -f "$WHITELIST" ] && wl_ips=$(grep -vE '^\s*(#|$)' "$WHITELIST" 2>/dev/null | wc -l || echo 0)
    [ -f "$WHITELIST_PORTS" ] && wl_ports=$(grep -vE '^\s*(#|$)' "$WHITELIST_PORTS" 2>/dev/null | wc -l || echo 0)
    test_result info "IP в белом списке" "$wl_ips"
    test_result info "Портов в белом списке" "$wl_ports"

    echo -e "\n${B_WHITE}▶ Сервисы${NC}"
    for s in antiscanner-fail2ban antiscanner-honeypot antiscanner-update antiscanner-unban.timer; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then
            test_result ok "$s" "running"
        else
            test_result info "$s" "stopped"
        fi
    done

    echo -e "\n${B_WHITE}▶ Honeypot${NC}"
    local hp_cnt; hp_cnt=$(ipset_count "$IPSET_HP")
    test_result info "Забанено" "$hp_cnt"
    test_result info "Уведомления" "$([ "${NOTIFY_HONEYPOT:-false}" = "true" ] && echo "включены" || echo "отключены")"
    test_result info "Cooldown" "${HONEYPOT_COOLDOWN} сек"

    echo -e "\n${B_WHITE}▶ Telegram${NC}"
    if [ -f "$TG_CONF" ]; then
        test_result ok "Конфиг" "$TG_CONF"
    else
        test_result warn "Telegram" "не настроен"
    fi

    echo
    echo -e "${B_CYAN}═══ Диагностика завершена ═══${NC}"
}

cmd_notify() {
    local module="${1:-status}" state="${2:-}"
    case "$module" in
        status)
            echo -e "${B_CYAN}═══ Уведомления ═══${NC}"
            for m in ALERTS REPORT HONEYPOT FAIL2BAN; do
                local var="NOTIFY_${m}"
                local v="${!var:-true}"
                [ "$v" = "true" ] && echo -e "  ${B_GREEN}✓${NC} $m" || echo -e "  ${B_RED}✗${NC} $m"
            done
            ;;
        alerts|report|honeypot|fail2ban)
            need_root
            [ -z "$state" ] && { echo "antiscanner notify $module {on|off}"; return 1; }
            local var="NOTIFY_${module^^}" val
            case "$state" in
                on|true|enable) val="true" ;;
                off|false|disable) val="false" ;;
                *) echo "state: on | off"; return 1 ;;
            esac
            grep -q "^${var}=" "$CONFIG" && sed -i "s/^${var}=.*/${var}=${val}/" "$CONFIG" || echo "${var}=${val}" >> "$CONFIG"
            echo -e "${B_GREEN}✓${NC} $var = $val"
            ;;
        *) echo "antiscanner notify {status | alerts|report|honeypot|fail2ban on|off}" ;;
    esac
}

cmd_uninstall() {
    need_root
    read -rp "Удалить полностью? [y/N]: " a
    [[ ! "$a" =~ ^[Yy]$ ]] && return
    systemctl disable --now antiscanner-fail2ban antiscanner-honeypot antiscanner-unban.timer antiscanner-update 2>/dev/null || true
    rm -f /etc/systemd/system/antiscanner-*.service /etc/systemd/system/antiscanner-*.timer
    systemctl daemon-reload
    cmd_honeypot remove 2>/dev/null || true
    cmd_ratelimit remove 2>/dev/null || true
    ipset destroy "$IPSET_F2B" 2>/dev/null || true
    ipset destroy "$IPSET_HP" 2>/dev/null || true
    for c in iptables ip6tables; do
        $c -D INPUT -j "$IPT_CHAIN" 2>/dev/null || true
        $c -F "$IPT_CHAIN" 2>/dev/null || true
        $c -X "$IPT_CHAIN" 2>/dev/null || true
    done
    (crontab -l 2>/dev/null | grep -vF 'antiscanner') | crontab - 2>/dev/null || true
    rm -f /etc/rsyslog.d/10-antiscanner.conf /etc/logrotate.d/antiscanner
    systemctl restart rsyslog 2>/dev/null || true
    rm -rf "$CONF_DIR"
    rm -f /var/log/antiscanner_*.log
    rm -f /usr/local/bin/antiscanner
    echo -e "${B_GREEN}✔ Удалён${NC}"
}

